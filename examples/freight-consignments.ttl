@prefix : <https://www.cranfield.ac.uk/transit/examples/freight-consignments#> .
@prefix transit: <https://www.cranfield.ac.uk/transit/core#> .
@prefix freight: <https://www.cranfield.ac.uk/transit/freight#> .
@prefix road: <https://www.cranfield.ac.uk/transit/road#> .
@prefix iof: <https://spec.industrialontologies.org/ontology/core/Core/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# One truck run carries two consignments for different consignees (groupage).
# Each consignment has its own leg carried by the run, a waybill, a pickup and
# a delivery. The second consignment is dangerous goods on a pallet.
# A reasoner should classify
#   run        as road:RoadTravelLeg (it is operated by a truck),
#   legA, legB as transit:TravelLeg with carriedBy the run,
#   acme/bolt  as transit:Shipper / transit:Consignee (from their roles),
#   fwd        as freight:FreightForwarder,
#   goodsB     as freight:PalletisedCargo,
#   returnRun  as freight:EmptyRun (asserted to carry no payload).

<https://www.cranfield.ac.uk/transit/examples/freight-consignments> a owl:Ontology ;
    owl:imports <https://www.cranfield.ac.uk/transit/freight> , <https://www.cranfield.ac.uk/transit/road> ;
    rdfs:label "Example: two consignments on one truck run"@en .

# parties
:acme a owl:NamedIndividual , iof:Organization ; rdfs:label "Acme Ltd (shipper)"@en ; iof:hasRole :acmeShipperRole .
:acmeShipperRole a owl:NamedIndividual , transit:ShipperRole .
:bolt a owl:NamedIndividual , iof:Organization ; rdfs:label "Bolt GmbH (consignee)"@en ; iof:hasRole :boltConsigneeRole .
:boltConsigneeRole a owl:NamedIndividual , transit:ConsigneeRole .
:haulier a owl:NamedIndividual , iof:Organization ; rdfs:label "Haulier SA (carrier)"@en ; iof:hasRole :haulierCarrierRole .
:haulierCarrierRole a owl:NamedIndividual , transit:CarrierRole .
:fwd a owl:NamedIndividual , iof:Organization ; rdfs:label "Forward & Co"@en ; iof:hasRole :fwdRole .
:fwdRole a owl:NamedIndividual , freight:FreightForwarderRole .

# consignments
:consA a owl:NamedIndividual , freight:Consignment ;
    rdfs:label "consignment A: machine parts"@en ;
    freight:hasShipper :acme ; freight:hasConsignee :bolt ; freight:hasCarrier :haulier ; freight:hasFreightForwarder :fwd ;
    freight:hasDeliveryTerm freight:DAP ;
    transit:hasMass :massA ;
    transit:hasTransportStatus freight:Delivered .
:massA a owl:NamedIndividual , transit:MassAmount ; transit:hasNumericalValue "1200.0"^^xsd:double ; transit:hasMeasurementUnit unit:KiloGM .
:consB a owl:NamedIndividual , freight:Consignment ;
    rdfs:label "consignment B: paint"@en ;
    freight:hasShipper :acme ; freight:hasConsignee :bolt ; freight:hasCarrier :haulier ;
    transit:hasTransportStatus freight:Delivered .
:goodsB a owl:NamedIndividual , freight:DangerousGoods ;
    rdfs:label "paint, UN 1263 class 3"@en ;
    freight:hasUNNumber "1263" ; freight:hasHazardClass "3" ;
    obo:BFO_0000176 :consB , :palletB .
:palletB a owl:NamedIndividual , freight:Pallet ; rdfs:label "pallet B"@en .
unit:KiloGM a owl:NamedIndividual , qudt:Unit ; rdfs:label "kilogram"@en .

# documents and order
:orderA a owl:NamedIndividual , freight:TransportOrder ; freight:orders :consA .
:waybillA a owl:NamedIndividual , freight:CMRConsignmentNote ; transit:documents :consA .
:waybillB a owl:NamedIndividual , freight:CMRConsignmentNote ; transit:documents :consB .
:podA a owl:NamedIndividual , freight:ProofOfDelivery ; transit:documents :consA .

# nodes
:acmeDock a owl:NamedIndividual , freight:LoadingBay ; rdfs:label "Acme loading bay 3"@en .
:boltDC a owl:NamedIndividual , freight:DistributionCentre ; rdfs:label "Bolt distribution centre"@en .
:haulierDepot a owl:NamedIndividual , freight:Depot ; rdfs:label "Haulier depot"@en .

# the truck run and the two consignment legs it carries
:truck a owl:NamedIndividual , road:Truck ; rdfs:label "truck HX-204"@en .
:run a owl:NamedIndividual , transit:VehicleRun ;
    rdfs:label "truck run Acme to Bolt"@en ;
    transit:operatedByVehicle :truck ;
    transit:departsAtOrigin :acmeDock ; transit:endsAtDestination :boltDC ;
    transit:hasPayload :consA , :consB ;
    transit:carries :legA , :legB ;
    transit:startsAtTimeInstance "2025-11-05T07:30:00Z"^^xsd:dateTimeStamp ;
    transit:endsAtTimeInstance "2025-11-05T15:10:00Z"^^xsd:dateTimeStamp ;
    transit:hasOccupancy :loadFactor .
:loadFactor a owl:NamedIndividual , transit:LoadFactor ; transit:hasNumericalValue "0.62"^^xsd:double .
:legA a owl:NamedIndividual , freight:ConsignmentLeg ; rdfs:label "leg of consignment A"@en ;
    transit:hasPayload :consA ; transit:carriedBy :run ; transit:operatedByVehicle :truck ;
    transit:departsAtOrigin :acmeDock ; transit:endsAtDestination :boltDC .
:legB a owl:NamedIndividual , freight:ConsignmentLeg ; rdfs:label "leg of consignment B"@en ;
    transit:hasPayload :consB ; transit:carriedBy :run ; transit:operatedByVehicle :truck ;
    transit:departsAtOrigin :acmeDock ; transit:endsAtDestination :boltDC .
:journeyA a owl:NamedIndividual , freight:FreightJourney ; rdfs:label "freight journey of consignment A"@en ;
    transit:hasPayload :consA ; transit:hasTravelLeg :legA ;
    transit:departsAtOrigin :acmeDock ; transit:endsAtDestination :boltDC .

# handling
:pickupA a owl:NamedIndividual , freight:Pickup ; freight:handlesPayload :consA ; obo:BFO_0000066 :acmeDock .
:loadingA a owl:NamedIndividual , freight:Loading ; freight:handlesPayload :consA ; freight:loadsOnto :truck .
:deliveryA a owl:NamedIndividual , freight:Delivery ; freight:handlesPayload :consA ; obo:BFO_0000066 :boltDC .
:appointment a owl:NamedIndividual , freight:DockAppointment ;
    transit:plannedStartTime "2025-11-05T07:00:00Z"^^xsd:dateTimeStamp ;
    transit:plannedEndTime "2025-11-05T08:00:00Z"^^xsd:dateTimeStamp .

# the empty return run
:returnRun a owl:NamedIndividual , transit:VehicleRun ;
    rdfs:label "empty return to depot"@en ;
    transit:operatedByVehicle :truck ;
    transit:departsAtOrigin :boltDC ; transit:endsAtDestination :haulierDepot ;
    a [ a owl:Restriction ; owl:onProperty transit:hasPayload ; owl:onClass transit:Payload ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ] .
