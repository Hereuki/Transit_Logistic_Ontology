@prefix : <https://www.cranfield.ac.uk/transit/air-domain#> .
@prefix transit: <https://www.cranfield.ac.uk/transit/core#> .
@prefix air: <https://www.cranfield.ac.uk/transit/air#> .
@prefix road: <https://www.cranfield.ac.uk/transit/road#> .
@prefix freight: <https://www.cranfield.ac.uk/transit/freight#> .
@prefix ad: <http://www.cranfield.ac.uk/ontology/air-domain#> .
@prefix iof: <https://spec.industrialontologies.org/ontology/core/Core/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://www.cranfield.ac.uk/transit/air-domain> a owl:Ontology ;
    owl:versionIRI <https://www.cranfield.ac.uk/transit/air-domain/2025-11> ;
    owl:versionInfo "0.7.0" ;
    owl:imports <https://www.cranfield.ac.uk/transit/air> ,
                <https://www.cranfield.ac.uk/transit/road> ,
                <https://www.cranfield.ac.uk/transit/freight> ,
                <http://www.cranfield.ac.uk/ontology/air-domain> ;
    rdfs:label "TransiT Air Domain Bridge"@en ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:abstract "Bridge that hangs the Air Domain Ontology (its own pragmatic top level) under the TransiT core, air, road and freight modules, and through them under BFO and IOF Core. It contains only subclass, equivalence and sub-property axioms; the Air Domain Ontology itself is unchanged by it and stays usable on its own. The parties the air ontology models as agent subclasses (shipper, consignee, exporter, importer) are made equivalent to agents bearing the matching TransiT role, so both readings coincide."@en ;
    rdfs:comment "Not aligned on purpose: ad:SustainableAviationFuel is a classification value (an EnergySource category) in the air ontology, whereas air:SustainableAviationFuel in the TransiT air module is a material fuel; ad:Terminal is an airport terminal building, whereas transit:Terminal is a transfer node; ad:hasPart and ad:partOf are used for both continuants and occurrents and are not mapped to the BFO part relations; ad:ULD is a cargo unit but not an ISO container."@en .

#################################################################
#    Top level: pragmatic air classes -> BFO / IOF
#################################################################

ad:Agent               rdfs:subClassOf iof:Agent .
ad:Organization        rdfs:subClassOf iof:Organization .
ad:Person              rdfs:subClassOf iof:Person .
ad:PhysicalObject      rdfs:subClassOf obo:BFO_0000040 .          # material entity
ad:Process             rdfs:subClassOf obo:BFO_0000015 .          # process
ad:Location            rdfs:subClassOf transit:Location .         # BFO site
ad:InformationObject   rdfs:subClassOf iof:InformationContentEntity .
ad:InformationSystem   rdfs:subClassOf iof:EngineeredSystem .
ad:Measurement         rdfs:subClassOf iof:ValueExpression .
ad:Category            rdfs:subClassOf iof:ValueExpression .
ad:Service             rdfs:subClassOf iof:Capability .           # a capability offered by a system or organization

#################################################################
#    Vehicles, infrastructure, payload
#################################################################

ad:Aircraft            rdfs:subClassOf air:Aircraft .
ad:GroundVehicle       rdfs:subClassOf road:RoadVehicle .
ad:Equipment           rdfs:subClassOf iof:MaterialArtifact .
ad:CargoContainer      rdfs:subClassOf transit:CargoUnit .
ad:Cargo               rdfs:subClassOf transit:Payload .
ad:Consignment         rdfs:subClassOf freight:Consignment .
ad:DangerousGoods      rdfs:subClassOf freight:DangerousGoods .

ad:Infrastructure      rdfs:subClassOf transit:Infrastructure .
ad:Airport             rdfs:subClassOf air:Airport .
ad:CargoTerminal       rdfs:subClassOf transit:TransferNode .
ad:MultimodalLink      rdfs:subClassOf transit:TransferNode .
ad:Route               rdfs:subClassOf air:Airway .
ad:ChargingStation     rdfs:subClassOf transit:ChargingStation .
ad:ChargingPoint       rdfs:subClassOf transit:ChargingPoint .
ad:Warehouse           rdfs:subClassOf freight:Warehouse .

#################################################################
#    Movements, handling and events
#################################################################

ad:Flight              rdfs:subClassOf air:Flight , transit:VehicleRun .
ad:CargoHandlingOperation rdfs:subClassOf freight:HandlingProcess .
ad:CustomsClearance    rdfs:subClassOf freight:CustomsClearance .
ad:OperationalDisruption rdfs:subClassOf transit:Disruption .

#################################################################
#    Parties: agent subclasses in the air ontology, roles in TransiT
#################################################################

ad:Airline             rdfs:subClassOf transit:Carrier .
ad:FreightForwarder    rdfs:subClassOf freight:FreightForwarder .
ad:Passenger           rdfs:subClassOf transit:Passenger .
ad:Shipper   owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ad:Agent [ a owl:Restriction ; owl:onProperty iof:hasRole ; owl:someValuesFrom transit:ShipperRole ] ) ] .
ad:Consignee owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ad:Agent [ a owl:Restriction ; owl:onProperty iof:hasRole ; owl:someValuesFrom transit:ConsigneeRole ] ) ] .
ad:Exporter  owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ad:Agent [ a owl:Restriction ; owl:onProperty iof:hasRole ; owl:someValuesFrom freight:ExporterRole ] ) ] .
ad:Importer  owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ad:Agent [ a owl:Restriction ; owl:onProperty iof:hasRole ; owl:someValuesFrom freight:ImporterRole ] ) ] .

#################################################################
#    Information
#################################################################

ad:Identifier          rdfs:subClassOf iof:Identifier .
ad:FlightSchedule      rdfs:subClassOf transit:Schedule .
ad:DispatchSchedule    rdfs:subClassOf transit:Schedule .
ad:Slot                rdfs:subClassOf transit:TimeSlot .
ad:AirwayBill          rdfs:subClassOf freight:AirWaybill .
ad:TransportMode       rdfs:subClassOf transit:TransportMode .
ad:EnergyUnit          rdfs:subClassOf transit:EnergyAmount .
ad:CarbonEmission      rdfs:subClassOf transit:CarbonFootprint .
ad:EnergySource        rdfs:seeAlso transit:EnergyCarrier .

#################################################################
#    Properties
#################################################################

ad:usesAircraft        rdfs:subPropertyOf transit:operatedByVehicle .
ad:departedFrom        rdfs:subPropertyOf transit:departsAtOrigin .
ad:arrivedAt           rdfs:subPropertyOf transit:endsAtDestination .
ad:hasIntermediateStop rdfs:subPropertyOf transit:passesBy .
ad:carriesCargo        rdfs:subPropertyOf transit:hasPayload .
ad:carriesPassenger    rdfs:subPropertyOf transit:hasParticipantsInMovement .
ad:consumesEnergy      rdfs:subPropertyOf transit:hasEnergyAmount .
ad:emitsCarbon         rdfs:subPropertyOf iof:hasValueExpressionAtSomeTime .
ad:hasName             rdfs:subPropertyOf transit:hasName .
ad:hasShipper          rdfs:subPropertyOf freight:hasShipper .
ad:hasConsignee        rdfs:subPropertyOf freight:hasConsignee .
ad:usesAirline         rdfs:subPropertyOf freight:hasCarrier .
ad:handledByFreightForwarder rdfs:subPropertyOf freight:hasFreightForwarder .
ad:usesAirwayBill      rdfs:subPropertyOf [ owl:inverseOf transit:documents ] .   # sub-property of the inverse, so transit:documents keeps its own domain and range
