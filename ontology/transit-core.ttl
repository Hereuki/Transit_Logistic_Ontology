@prefix : <https://www.cranfield.ac.uk/transit/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iof: <https://spec.industrialontologies.org/ontology/core/Core/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.cranfield.ac.uk/transit/core> a owl:Ontology ;
    rdfs:label "TransiT Core Ontology"@en ;
    dcterms:abstract "The TransiT Core Ontology contains the mode-neutral terms common to transport and logistics: movements, journeys and travel legs, vehicles, payload and passengers, infrastructure and transfer nodes, energy and charging, emissions, roles, and design specifications. It uses BFO as top-level ontology and IOF Core as mid-level ontology. Mode-specific content (road, rail, air, maritime) and their intersections live in separate modules that import this core."@en ;
    dcterms:contributor "Bernadin Namoano, Cranfield University",
        "Navya Nayak, Cranfield University" ;
    dcterms:creator "Zhengyu Liu, Université de Technologie Tarbes Occitanie Pyrénées - UTTOP" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:title "TransiT Core Ontology"@en ;
    rdfs:comment "Classes annotated with iof-av:adaptedFrom an IES4 IRI are TransiT's own terms placed under BFO and IOF Core; IES4 is a 4D ontology and is not imported. Extension points for mode modules: Vehicle, TravelLeg, Infrastructure, TransportWay, TransferNode, Terminal, the TransportMode individuals and the hasTransportMode property."@en ;
    owl:imports <https://spec.industrialontologies.org/ontology/202401/core/Core/> ;
    owl:versionIRI <https://www.cranfield.ac.uk/transit/core/2025-11> ;
    owl:versionInfo "0.7.0" .

:Byproduct a owl:Class ;
    rdfs:label "Byproduct"@en ;
    rdfs:subClassOf :MaterialResidual ;
    iof-av:naturalLanguageDefinition "A secondary material or substance that is produced during the manufacturing or chemical process, which is not the primary product but may have commercial value or potential reuse."@en .

:Cancellation a owl:Class ;
    rdfs:label "Cancellation"@en ;
    rdfs:subClassOf :Disruption ;
    iof-av:naturalLanguageDefinition "A disruption in which a scheduled movement does not take place."@en .

:CarbonDioxideEmission a owl:Class ;
    rdfs:label "Carbon Dioxide Emission"@en ;
    rdfs:subClassOf :GreenhouseGasEmission ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :GreenhouseGasEmission [ a owl:Restriction ;
                        owl:onProperty :hasSubstance ;
                        owl:someValuesFrom :CarbonDioxide ] ) ] ;
    iof-av:naturalLanguageDefinition "A greenhouse gas emission whose substance is carbon dioxide."@en ;
    iof-av:synonym "Carbon Emission"@en .

:CarbonFootprint a owl:Class ;
    rdfs:label "Carbon footprint"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:isAbout ;
            owl:someValuesFrom obo:BFO_0000001 ],
        iof:ValueExpression ;
    iof-av:naturalLanguageDefinition "A value expression of the net amount of greenhouse gas emissions attributable to an entity, process or product, expressed in carbon dioxide equivalent."@en .

:CargoUnit a owl:Class ;
    rdfs:label "Cargo Unit"@en ;
    rdfs:subClassOf iof:MaterialArtifact ;
    iof-av:naturalLanguageDefinition "A material artifact designed to hold payload so that it can be handled and transferred between vehicles as one unit, e.g. a container, swap body, pallet or parcel."@en .

:Carrier a owl:Class ;
    rdfs:label "Carrier"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( iof:Agent [ a owl:Restriction ;
                        owl:onProperty iof:hasRole ;
                        owl:someValuesFrom :CarrierRole ] ) ] ;
    iof-av:naturalLanguageDefinition "An agent that bears a carrier role."@en .

:ChargerCommunicationProtocolSpecification a owl:Class ;
    rdfs:label "Charger Communication Protocol Specification"@en ;
    rdfs:subClassOf :ChargerDesignSpecification ;
    iof-av:naturalLanguageDefinition "A charger design specification prescribing the communication protocol between charger and vehicle during charging, e.g. ISO 15118 or OCPP."@en .

:ChargerConnectorSpecification a owl:Class ;
    rdfs:label "Charger Connector Specification"@en ;
    rdfs:subClassOf :ChargerDesignSpecification ;
    iof-av:naturalLanguageDefinition "A charger design specification prescribing the connector type and pin configuration of the charging interface, ensuring compatibility between charger and vehicle. Replaces DesignedConnectorType and DesignedPin."@en .

:ChargerCurrentSpecification a owl:Class ;
    rdfs:label "Charger Current Specification"@en ;
    rdfs:subClassOf :ChargerDesignSpecification ;
    iof-av:naturalLanguageDefinition "A charger design specification prescribing the electrical current, in amperes, for which the charger is designed."@en .

:ChargerFrequencySpecification a owl:Class ;
    rdfs:label "Charger Frequency Specification"@en ;
    rdfs:subClassOf :ChargerDesignSpecification ;
    iof-av:naturalLanguageDefinition "A charger design specification prescribing the electrical frequency, in hertz, for which the charger is designed."@en .

:ChargerPhaseSpecification a owl:Class ;
    rdfs:label "Charger Phase Specification"@en ;
    rdfs:subClassOf :ChargerDesignSpecification ;
    iof-av:naturalLanguageDefinition "A charger design specification prescribing the phase configuration (single-phase or three-phase) of the electrical supply."@en .

:ChargerPowerSpecification a owl:Class ;
    rdfs:label "Charger Power Specification"@en ;
    rdfs:subClassOf :ChargerDesignSpecification ;
    iof-av:naturalLanguageDefinition "A charger design specification prescribing the maximum power, in watts or kilowatts, the charger is designed to deliver."@en .

:ChargerVoltageSpecification a owl:Class ;
    rdfs:label "Charger Voltage Specification"@en ;
    rdfs:subClassOf :ChargerDesignSpecification ;
    iof-av:naturalLanguageDefinition "A charger design specification prescribing the voltage, in volts, for which the charger is designed. Replaces DesignedTension."@en .

:ChargingPoint a owl:Class ;
    rdfs:label "Charging Point"@en ;
    rdfs:comment """A charging station can have one or multilpe charging point, and a charging point have 1+charger.\r\r\r\r
Each charging point belongs to a specific energy provider, e.g. tesla, total""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:hasComponentPartAtSomeTime ;
            owl:someValuesFrom :EnergyCharger ],
        iof:MaterialArtifact ;
    iof-av:naturalLanguageDefinition "A material artifact, installed at a charging station or elsewhere, that holds one or more energy chargers at a designated spot where a vehicle or device can be charged."@en,
        "A site that serves as a designated location where one or more chargers are installed to provide energy to electric or fuel-powered vehicles or devices."@en .

:ChargingSession a owl:Class ;
    rdfs:label "Charging Session"@en ;
    rdfs:subClassOf :ElectricitySupply ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ElectricitySupply [ a owl:Restriction ;
                        owl:onProperty :suppliedBy ;
                        owl:someValuesFrom :EnergyCharger ] ) ] ;
    iof-av:naturalLanguageDefinition "An electricity supply delivered through an energy charger to a vehicle or device, from plug-in to unplug, with its energy amount."@en .

:ChargingStation a owl:Class ;
    rdfs:label "Charging Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:hasComponentPartAtSomeTime ;
            owl:someValuesFrom :EnergyCharger ],
        :EnergySupplyStation ;
    iof-av:naturalLanguageDefinition "A ChargingStation is a land station dedicated to recharging electric vehicles.."@en .

:Consignee a owl:Class ;
    rdfs:label "Consignee"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( iof:Agent [ a owl:Restriction ;
                        owl:onProperty iof:hasRole ;
                        owl:someValuesFrom :ConsigneeRole ] ) ] ;
    iof-av:naturalLanguageDefinition "An agent that bears a consignee role."@en .

:ConsolidationStation a owl:Class ;
    rdfs:label "Consolidaion Station"@en ;
    rdfs:comment "Previously named switch station"@en ;
    rdfs:subClassOf :TransferNode ;
    skos:example "A distribution center"@en ;
    iof-av:naturalLanguageDefinition "A transfer node at which payload from several movements is consolidated into, or deconsolidated from, one vehicle or cargo unit."@en ;
    iof-av:synonym "Consolidation Hub" .

:CorrosionProcess a owl:Class ;
    rdfs:label "Corrosion Process"@en ;
    rdfs:comment "Corrosion often accompanies industrial, manufacturing, or service operations, even though it is not part of the intended or planned function." ;
    rdfs:subClassOf :InherentProcess ;
    iof-av:naturalLanguageDefinition "A spontaneous degradation process in which a material, typically a metal, deteriorates due to chemical or electrochemical reactions with its environment. This process occurs unintentionally during the operation or lifespan of equipment or components"@en .

:CrewMember a owl:Class ;
    rdfs:label "Crew Member"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( iof:Person [ a owl:Restriction ;
                        owl:onProperty iof:hasRole ;
                        owl:someValuesFrom :CrewRole ] ) ] ;
    iof-av:naturalLanguageDefinition "A person who bears a crew role."@en .

:Delay a owl:Class ;
    rdfs:label "Delay"@en ;
    rdfs:subClassOf :Disruption ;
    iof-av:naturalLanguageDefinition "A disruption in which a movement starts or ends later than its schedule prescribes."@en .

:Distance a owl:Class ;
    rdfs:label "Distance"@en ;
    rdfs:subClassOf :GeometricalQuality ;
    iof-av:naturalLanguageDefinition "A geometrical quality that is the length of the path covered by a movement, or between two locations."@en .

:Driver a owl:Class ;
    rdfs:label "Driver"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( iof:Person [ a owl:Restriction ;
                        owl:onProperty iof:hasRole ;
                        owl:someValuesFrom :DriverRole ] ) ] ;
    iof-av:naturalLanguageDefinition "A person who bears a driver role, i.e. controls and operates a vehicle."@en .

:ElectricVehicle a owl:Class ;
    rdfs:label "Electric Vehicle"@en ;
    rdfs:subClassOf :Vehicle ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Vehicle [ a owl:Restriction ;
                        owl:onProperty :appliesEnergy ;
                        owl:someValuesFrom :ElectricitySupply ] ) ] ;
    iof-av:naturalLanguageDefinition "A vehicle that applies an electricity supply, i.e. is powered at least in part by electricity delivered through a charger or a catenary. A bi-mode vehicle is both an electric vehicle and a fuel-burning one."@en .

:ElectricVehicleCharger a owl:Class ;
    rdfs:label "Electric vehicle charger"@en ;
    rdfs:subClassOf :ElectricityCharger ;
    iof-av:naturalLanguageDefinition "A specialized electricity charger that delivers electrical energy to a electric vehicle"@en .

:ElectricityChargerRole a owl:Class ;
    rdfs:label "Electricity Charger Role"@en ;
    rdfs:subClassOf :EnergyChargerRole ;
    owl:disjointWith :FuelChargerRole ;
    skos:example "an electric vehicle (EV) charger in charging station." ;
    iof-av:naturalLanguageDefinition "An energy charger role held by a device that supplies electricity."@en .

:EnergyChargedRole a owl:Class ;
    rdfs:label "Energy Charged Role"@en ;
    rdfs:subClassOf :EnergyTransferRole ;
    owl:disjointWith :EnergyChargerRole ;
    skos:example "A battery being charged in a power system,  a vehicle whose tank is being fueled in a gaz station, a capacitor in an electronic circuit"@en ;
    iof-av:naturalLanguageDefinition "A role assumed by an entity that receives energy."@en ;
    iof-av:synonym """Powered Device Role\r\r\r\r
Receiving device role""" .

:EnergyGenerationProcess a owl:Class ;
    rdfs:label "Energy Generation Process"@en ;
    rdfs:subClassOf :EnergyProcess ;
    iof-av:naturalLanguageDefinition "An energy process in which energy is produced from a primary source, e.g. by combustion or from solar radiation."@en .

:EnergyProvider a owl:Class ;
    rdfs:label "Energy Provider"@en ;
    rdfs:subClassOf iof:Supplier ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( iof:Supplier [ a owl:Restriction ;
                        owl:onProperty iof:hasRole ;
                        owl:someValuesFrom :EnergyProviderRole ] ) ] ;
    skos:example "Entreprice such as Total, EDF"@en ;
    iof-av:naturalLanguageDefinition "A supplier that offers to sell or provide an energy carrier, e.g. fuel or electricity."@en .

:Fleet a owl:Class ;
    rdfs:label "Fleet"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000115 ;
            owl:someValuesFrom :Vehicle ],
        [ a owl:Restriction ;
            owl:allValuesFrom :Vehicle ;
            owl:onProperty obo:BFO_0000115 ],
        :GroupOfArtifacts ;
    iof-av:naturalLanguageDefinition "A group of vehicles operated by one transport operator."@en .

:FuelStation a owl:Class ;
    rdfs:label "Fuel Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:hasComponentPartAtSomeTime ;
            owl:someValuesFrom :FuelDispenser ],
        :EnergySupplyStation ;
    iof-av:naturalLanguageDefinition "An energy supply station at which fuel is dispensed into vehicles."@en .

:GHGSink a owl:Class ;
    rdfs:label "GHG sink"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty iof:hasRole ;
                        owl:someValuesFrom :GHGSinkRole ] ) ] ;
    iof-av:naturalLanguageDefinition "An entity that removes greenhouse gases from the atmosphere through physical, chemical, or biological means. GHG sinks mitigate climate change by reducing the net concentration of GHGs"@en ;
    iof-av:synonym "GHG remover" .

:Hydrogen a owl:Class ;
    rdfs:label "Hydrogen"@en ;
    rdfs:subClassOf :Fuel ;
    iof-av:naturalLanguageDefinition "A fuel that is a portion of molecular hydrogen, used in fuel cells or combustion engines."@en .

:Incident a owl:Class ;
    rdfs:label "Incident"@en ;
    rdfs:subClassOf :Disruption ;
    iof-av:naturalLanguageDefinition "A disruption caused by an unplanned event such as an accident, a breakdown, a strike or severe weather."@en .

:IntermodalJourney a owl:Class ;
    rdfs:label "Intermodal Journey"@en ;
    rdfs:subClassOf :Journey ;
    iof-av:naturalLanguageDefinition "A journey whose travel legs use at least two different transport modes. The intersection modules define its mode-specific subclasses, e.g. a rail-road journey."@en .

:MethaneEmission a owl:Class ;
    rdfs:label "Methane Emission"@en ;
    rdfs:subClassOf :GreenhouseGasEmission ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :GreenhouseGasEmission [ a owl:Restriction ;
                        owl:onProperty :hasSubstance ;
                        owl:someValuesFrom :Methane ] ) ] ;
    iof-av:naturalLanguageDefinition "A greenhouse gas emission whose substance is methane."@en .

:OrderContent a owl:Class ;
    rdfs:label "Order Content"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:prescribedBy ;
            owl:someValuesFrom :Order ],
        :GroupOfArtifacts ;
    iof-av:naturalLanguageDefinition "A group of artifacts that is the subject of an order."@en .

:OrderIdentifier a owl:Class ;
    rdfs:label "Order Identifier"@en ;
    rdfs:subClassOf iof:Identifier ;
    iof-av:naturalLanguageDefinition "An identifier that designates an order."@en .

:Passenger a owl:Class ;
    rdfs:label "Passenger"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( iof:Person [ a owl:Restriction ;
                        owl:onProperty iof:hasRole ;
                        owl:someValuesFrom :PassengerRole ] ) ] ;
    iof-av:naturalLanguageDefinition "A person who bears a passenger role in a movement."@en .

:PedestrianLeg a owl:Class ;
    rdfs:label "Pedestrian Leg"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :WalkingMode ;
            owl:onProperty :hasTransportMode ],
        :TravelLeg ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :TravelLeg [ a owl:Restriction ;
                        owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onClass :Vehicle ;
                        owl:onProperty :operatedByVehicle ] ) ] ;
    iof-av:naturalLanguageDefinition "A travel leg performed on foot, without a vehicle, e.g. from a railway station to an office. Its transport mode is walking."@en .

:RouteSegment a owl:Class ;
    rdfs:label "Route Segment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000176 ;
            owl:someValuesFrom :Route ],
        iof:PlanSpecification ;
    iof-av:naturalLanguageDefinition "A plan specification that is part of a route and prescribes one travel leg."@en .

:Shipper a owl:Class ;
    rdfs:label "Shipper"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( iof:Agent [ a owl:Restriction ;
                        owl:onProperty iof:hasRole ;
                        owl:someValuesFrom :ShipperRole ] ) ] ;
    iof-av:naturalLanguageDefinition "An agent that bears a shipper role."@en .

:Terminal a owl:Class ;
    rdfs:label "Correspondence Port"@en ;
    rdfs:subClassOf :TransferNode ;
    iof-av:naturalLanguageDefinition "A CorrespondencePort is a specialized correspondence equipped with facilities for mode transitions, cargo handling, or passenger services, typically hosting more complex operations than a simple rest stop."@en,
        "A transfer node equipped with facilities for mode transitions, cargo handling or passenger services. Mode modules add airports, seaports, railway stations and road terminals; intersection modules define the terminals that connect two modes. Replaces the earlier class CorrespondencePort."@en .

:TimeSlot a owl:Class ;
    rdfs:label "Time Slot"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:prescribes ;
            owl:someValuesFrom :StopCall ],
        :Schedule ;
    iof-av:naturalLanguageDefinition "A schedule that prescribes the time window within which one vehicle run may call at one node: a dock appointment at a warehouse, an airport slot, a berth window."@en .

:TransportCapacityDesignSpecification a owl:Class ;
    rdfs:label "Transport Capacity Design Specification"@en ;
    rdfs:subClassOf :TransportDesignSpecification ;
    iof-av:naturalLanguageDefinition "Transport design specification that describes what can be carried or taken as payload while specifying the amount."@en ;
    iof-av:synonym "Payload specification"@en .

:TransportMonetaryCostSpecification a owl:Class ;
    rdfs:label "MoneytaryCostSpecification"@en ;
    rdfs:subClassOf :TransportDesignSpecification ;
    iof-av:naturalLanguageDefinition "A transport design specification prescribing the financial cost, in a currency, of a process, item or service."@en .

:TransportPowerSpecification a owl:Class ;
    rdfs:label "Transport Power Specification"@en ;
    rdfs:subClassOf :TransportDesignSpecification ;
    iof-av:naturalLanguageDefinition "Transport design specification that describes the power used, e.g., Watt"@en .

:TransportWay a owl:Class ;
    rdfs:label "Transport Way"@en ;
    rdfs:subClassOf :Infrastructure ;
    iof-av:naturalLanguageDefinition "Infrastructure that provides the path along which vehicles move, e.g. a road, a railway, a waterway or an airway. Mode modules add the specific kinds."@en .

:VehicleIdentifier a owl:Class ;
    rdfs:label "Vehicle Identifier"@en ;
    rdfs:subClassOf :ArtifactIdentifier ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ArtifactIdentifier [ a owl:Restriction ;
                        owl:onProperty iof:designates ;
                        owl:someValuesFrom :Vehicle ] ) ] ;
    iof-av:naturalLanguageDefinition "An artifact identifier that designates a vehicle."@en .

:Waste a owl:Class ;
    rdfs:label "Waste"@en ;
    rdfs:subClassOf :MaterialResidual ;
    iof-av:naturalLanguageDefinition "A material or substance resulting from a process that has no intended value or use and is typically discarded, requiring treatment or disposal to minimize environmental impact."@en .

:Weight a owl:Class ;
    rdfs:label "Weight"@en ;
    rdfs:subClassOf :PhysicalQuality ;
    iof-av:naturalLanguageDefinition "A physical quality that is the mass of an entity."@en .

:callsAt a owl:ObjectProperty ;
    rdfs:label "calls at"@en ;
    rdfs:domain :VehicleRun ;
    rdfs:range :Stop ;
    rdfs:subPropertyOf :passesBy ;
    iof-av:naturalLanguageDefinition "Relates a vehicle run to a stop it calls at between its origin and its destination."@en .

:carriedBy a owl:ObjectProperty ;
    rdfs:label "carried by"@en ;
    rdfs:domain :TravelLeg ;
    rdfs:range :VehicleRun ;
    rdfs:subPropertyOf obo:BFO_0000132 ;
    owl:inverseOf :carries ;
    iof-av:naturalLanguageDefinition "Relates a passenger's or consignment's travel leg to the vehicle run it is an occurrent part of. Allocating the run's energy and emissions across what it carried goes through this relation."@en .

:chargesEnergy a owl:ObjectProperty ;
    rdfs:label "charges Energy"@en ;
    rdfs:domain :EnergyCharger ;
    rdfs:range :EnergyCarrier ;
    rdfs:subPropertyOf :appliesEnergy ;
    iof-av:naturalLanguageDefinition "Relates an energy charger to the energy it delivers to another device or vehicle."@en .

:crews a owl:ObjectProperty ;
    rdfs:label "crews"@en ;
    rdfs:domain iof:Person ;
    rdfs:range :VehicleRun ;
    rdfs:subPropertyOf :participatesInMovement ;
    iof-av:naturalLanguageDefinition "Relates a crew member or driver to a vehicle run they operate or serve on."@en .

:documents a owl:ObjectProperty ;
    rdfs:label "documents"@en ;
    rdfs:domain :TransportDocument ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :Movement :Payload :Booking ) ] ;
    rdfs:subPropertyOf iof:isAbout ;
    iof-av:naturalLanguageDefinition "Relates a transport document to the movement, payload or booking it is about."@en .

:drives a owl:ObjectProperty ;
    rdfs:label "drives"@en ;
    rdfs:domain iof:Person ;
    rdfs:range :HumanDrivenVehicle ;
    owl:inverseOf :drivenBy ;
    iof-av:naturalLanguageDefinition "Relates a person bearing a driver role to the human-driven vehicle they control."@en .

:hasConsumer a owl:ObjectProperty ;
    rdfs:label "has Consumer"@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range iof:Agent ;
    rdfs:subPropertyOf obo:BFO_0000057 ;
    iof-av:naturalLanguageDefinition "Relates a process to the agent that consumes its output."@en .

:hasDistanceAmount a owl:ObjectProperty ;
    rdfs:label "has distance amount"@en ;
    rdfs:domain :Movement ;
    rdfs:range :DistanceAmount ;
    rdfs:subPropertyOf :hasMeasuredDimensionValueAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates a movement to a value expression of the distance it covers."@en .

:hasEmissionFactor a owl:ObjectProperty ;
    rdfs:label "has emission factor"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Fuel :ElectricitySupply :Movement ) ] ;
    rdfs:range :EmissionFactor ;
    rdfs:subPropertyOf iof:hasValueExpressionAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates a fuel portion, an electricity supply or a movement to the emission factor used to compute its emissions."@en .

:hasMass a owl:ObjectProperty ;
    rdfs:label "has mass"@en ;
    rdfs:domain obo:BFO_0000040 ;
    rdfs:range :MassAmount ;
    rdfs:subPropertyOf :hasMeasuredDimensionValueAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates a material entity, e.g. a consignment or a vehicle, to a value expression of its mass."@en .

:hasMeasuredCostValueAtSomeTime a owl:ObjectProperty ;
    rdfs:label "has Measured Cost Value At Some Time"@en ;
    rdfs:subPropertyOf iof:hasMeasuredValueAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates an entity to a value expression of its measured monetary cost."@en .

:hasMeasuredTemporalValueAtSomeTime a owl:ObjectProperty ;
    rdfs:label "has Measured Temporal Value At Some Time"@en ;
    rdfs:range iof:TemporalDurationValueExpression ;
    rdfs:subPropertyOf iof:hasMeasuredValueAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates an entity to a value expression of a measured duration."@en .

:hasName a owl:DatatypeProperty ;
    rdfs:label "has Name"@en ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition "A human-readable name of an entity."@en .

:hasNumericalValue a owl:DatatypeProperty ;
    rdfs:label "has Numerical Value"@en ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf iof:hasSimpleExpressionValue ;
    iof-av:naturalLanguageDefinition "The numerical value carried by a value expression."@en .

:hasOccupancy a owl:ObjectProperty ;
    rdfs:label "has occupancy"@en ;
    rdfs:domain :VehicleRun ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :Occupancy :LoadFactor ) ] ;
    rdfs:subPropertyOf iof:hasMeasuredValueAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates a vehicle run to its measured occupancy or load factor."@en .

:hasPayload a owl:ObjectProperty ;
    rdfs:label "has Payload"@en ;
    rdfs:comment "put under is carrier of" ;
    rdfs:domain :Movement ;
    rdfs:range :Payload ;
    rdfs:subPropertyOf :hasParticipantsInMovement ;
    iof-av:naturalLanguageDefinition "Relates a movement to the payload it carries."@en .

:hasProducer a owl:ObjectProperty ;
    rdfs:label "has Producer"@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range iof:Agent ;
    rdfs:subPropertyOf obo:BFO_0000057 ;
    iof-av:naturalLanguageDefinition "Relates a process to the agent that produces its output."@en .

:hasTariff a owl:ObjectProperty ;
    rdfs:label "has tariff"@en ;
    rdfs:domain :TransportService ;
    rdfs:range :Tariff ;
    iof-av:naturalLanguageDefinition "Relates a transport service to a tariff that prices it."@en .

:hasTransportStatus a owl:ObjectProperty ;
    rdfs:label "has transport status"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Movement :Payload ) ] ;
    rdfs:range :TransportStatus ;
    rdfs:subPropertyOf iof:hasValueExpressionAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates a movement or a payload to its transport status at some time."@en .

:hasTransportWork a owl:ObjectProperty ;
    rdfs:label "has transport work"@en ;
    rdfs:domain :Movement ;
    rdfs:range :TransportWork ;
    rdfs:subPropertyOf iof:hasMeasuredValueAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates a movement to the transport work it performed."@en .

:hasUnit a owl:DatatypeProperty ;
    rdfs:label "has Unit"@en ;
    rdfs:comment "Deprecated since 0.4.0: use hasMeasurementUnit with a QUDT unit individual instead."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf iof:hasSimpleExpressionValue ;
    owl:deprecated true ;
    iof-av:naturalLanguageDefinition "The unit of measure, as a string, of the numerical value carried by a value expression."@en .

:hasVolume a owl:ObjectProperty ;
    rdfs:label "has volume"@en ;
    rdfs:domain obo:BFO_0000040 ;
    rdfs:range :VolumeAmount ;
    rdfs:subPropertyOf :hasMeasuredDimensionValueAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates a material entity to a value expression of its volume."@en .

:isCarbonNeutral a owl:DatatypeProperty ;
    rdfs:label "is Carbon Neutral"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( obo:BFO_0000015 obo:BFO_0000040 ) ] ;
    rdfs:range xsd:boolean ;
    iof-av:naturalLanguageDefinition "True if the process or material entity results in no net greenhouse gas emissions."@en .

:isConducted a owl:DatatypeProperty ;
    rdfs:label "is Conducted"@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range xsd:boolean ;
    iof-av:naturalLanguageDefinition "True if the process has started."@en .

:isFinished a owl:DatatypeProperty ;
    rdfs:label "is Finished"@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range xsd:boolean ;
    iof-av:naturalLanguageDefinition "True if the process has ended."@en .

:isInUse a owl:DatatypeProperty ;
    rdfs:label "is In Use"@en ;
    rdfs:domain :Device ;
    rdfs:range xsd:boolean ;
    iof-av:naturalLanguageDefinition "True if the device is currently in use."@en .

:isOnTime a owl:DatatypeProperty ;
    rdfs:label "is On Time"@en ;
    rdfs:domain :Movement ;
    rdfs:range xsd:boolean ;
    iof-av:naturalLanguageDefinition "True if the movement keeps to its schedule."@en .

:owns a owl:ObjectProperty ;
    rdfs:label "owns"@en ;
    rdfs:domain iof:Agent ;
    rdfs:range obo:BFO_0000040 ;
    owl:inverseOf :ownedBy ;
    iof-av:naturalLanguageDefinition "Relates a person or organization to a material entity it owns."@en .

:plannedEndTime a owl:DatatypeProperty ;
    rdfs:label "planned end time"@en ;
    rdfs:domain :Schedule ;
    rdfs:range xsd:dateTimeStamp ;
    iof-av:naturalLanguageDefinition "The time stamp at which a schedule prescribes a movement to end. The actual end is recorded on the movement with endsAtTimeInstance."@en .

:plannedStartTime a owl:DatatypeProperty ;
    rdfs:label "planned start time"@en ;
    rdfs:domain :Schedule ;
    rdfs:range xsd:dateTimeStamp ;
    iof-av:naturalLanguageDefinition "The time stamp at which a schedule prescribes a movement to start. The actual start is recorded on the movement with startsAtTimeInstance."@en .

:realisesService a owl:ObjectProperty ;
    rdfs:label "realises service"@en ;
    rdfs:domain :VehicleRun ;
    rdfs:range :TransportService ;
    iof-av:naturalLanguageDefinition "Relates a vehicle run to the transport service it is an instance of, e.g. a bus run to its line."@en .

:suppliesElectricityTo a owl:ObjectProperty ;
    rdfs:label "supplies electricity to"@en ;
    rdfs:domain :ElectricitySupply ;
    rdfs:range :Device ;
    rdfs:subPropertyOf obo:BFO_0000057 ;
    iof-av:naturalLanguageDefinition "Relates an electricity supply process to the device or vehicle that receives the charge."@en .

:usesEnergy a owl:ObjectProperty ;
    rdfs:label "uses Energy"@en ;
    rdfs:range :EnergyCarrier ;
    rdfs:subPropertyOf :appliesEnergy ;
    iof-av:naturalLanguageDefinition "Relates a device or vehicle to the energy it consumes."@en .

:AirMode a owl:NamedIndividual,
        :TransportMode ;
    rdfs:label "air mode"@en .

:AutonomousVehicle a owl:Class ;
    rdfs:label "Autonomous Vehicle"@en ;
    rdfs:subClassOf :Vehicle ;
    iof-av:naturalLanguageDefinition "A road vehicle operating autonomously without real-time human control or a human driver."@en,
        "A vehicle that operates without real-time human control. Orthogonal to transport mode."@en ;
    iof-av:synonym "AVs" .

:CarbonDioxide a owl:Class ;
    rdfs:label "Carbon Dioxide"@en ;
    rdfs:subClassOf :GreenhouseGas ;
    owl:disjointWith :Methane ;
    iof-av:naturalLanguageDefinition "A colorless, odorless greenhouse gas composed of one carbon atom and two oxygen atoms (CO₂). It is a major product of combustion and respiration, and the primary anthropogenic contributor to global warming"@en ;
    iof-av:synonym "CO2" .

:CarrierRole a owl:Class ;
    rdfs:label "Carrier Role"@en ;
    rdfs:subClassOf :TransportOperatorRole ;
    iof-av:naturalLanguageDefinition "A transport operator role held by an organization or person that performs the transport of a consignment on behalf of a shipper."@en .

:ConsigneeRole a owl:Class ;
    rdfs:label "Consignee Role"@en ;
    rdfs:subClassOf iof:AgentRole ;
    iof-av:naturalLanguageDefinition "An agent role held by the party to whom payload is to be delivered."@en .

:CrewRole a owl:Class ;
    rdfs:label "Crew Role"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:roleOf ;
            owl:someValuesFrom iof:Person ],
        :TransportRole ;
    iof-av:naturalLanguageDefinition "A transport role held by a person who operates or serves aboard a vehicle as part of its crew: a train driver, a ship's master or deckhand, a pilot, a conductor. The driver role is the road-vehicle special case."@en .

:DesignedChargerFunction a owl:Class ;
    rdfs:label "Designed Charger Function"@en ;
    rdfs:subClassOf iof:DesignedFunction ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( iof:DesignedFunction [ a owl:Restriction ;
                        owl:onProperty iof:functionOf ;
                        owl:someValuesFrom :EnergyCharger ] ) ] ;
    iof-av:naturalLanguageDefinition "A function specifically designed to manage the charging process of an energy charger system.."@en .

:DistanceAmount a owl:Class ;
    rdfs:label "Distance Amount"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasMeasurementUnit ;
            owl:someValuesFrom qudt:Unit ],
        iof:ValueExpression ;
    iof-av:naturalLanguageDefinition "A value expression of a distance, with a numerical value and a unit such as kilometre."@en .

:DriverRole a owl:Class ;
    rdfs:label "Driver Role"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:roleOf ;
            owl:someValuesFrom iof:Person ],
        :TransportRole ;
    owl:disjointWith :PassengerRole ;
    skos:example "A car driver, a train conductor, a pilot." ;
    iof-av:naturalLanguageDefinition "A role assigned to an person responsible for controlling and operating a transport vehicle."@en .

:ElectricityCharger a owl:Class ;
    rdfs:label "Electricity Charger"@en ;
    rdfs:subClassOf :EnergyCharger ;
    owl:disjointWith :FuelDispenser ;
    iof-av:naturalLanguageDefinition "An energy charger through which electricity supply processes deliver charge to a receiving device or storage unit."@en .

:EmissionFactor a owl:Class ;
    rdfs:label "Emission Factor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasMeasurementUnit ;
            owl:someValuesFrom qudt:Unit ],
        [ a owl:Restriction ;
            owl:onClass :EmissionFactorBasis ;
            owl:onProperty :hasEmissionFactorBasis ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iof:ValueExpression ;
    iof-av:naturalLanguageDefinition "A value expression of the mass of greenhouse gas (in CO2 equivalent) released per unit of energy carrier used or per unit of transport work performed, e.g. kilograms per litre of diesel, per kilowatt-hour of electricity, or per tonne-kilometre. For electricity the basis states whether the factor is the location-based grid average or the market-based factor of the contracted supply."@en .

:EmissionUnitProcess a owl:Class ;
    rdfs:label "EmissionLeg"@en ;
    rdfs:comment "This is for modeling and mapping purpose. Each main emission process has at least 1 Unit process. A unit process has exactly one emitted gaz and one emitter." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :GreenhouseGasEmission ;
            owl:onProperty :hasEmission ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :GHGSource ;
            owl:onProperty :hasEmitter ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :EmissionProcess ;
    iof-av:naturalLanguageDefinition "An emission process that releases exactly one kind of emission from exactly one emitter. Used to decompose a real emission process, which usually releases several gases, into units that can be quantified separately."@en ;
    iof-av:synonym "Emission Unit Process" .

:EnergyChargingProcess a owl:Class ;
    rdfs:label "Energy Charging Process"@en ;
    rdfs:subClassOf :EnergyProcess ;
    skos:example "Charging an electric vehicle at a charging station, refueling a hydrogen-powered vehicle, recharging a battery storage system from a renewable energy source." ;
    iof-av:naturalLanguageDefinition "An energy process that involves the controlled transfer of energy into an energy storage system or directly into a consuming device."@en .

:EnergyProviderRole a owl:Class ;
    rdfs:label "Energy Provider Role"@en ;
    rdfs:subClassOf iof:SupplierRole ;
    iof-av:naturalLanguageDefinition "supplier role held by a person (less likely) or organization when it offers to sell or provide a energy service"@en .

:EnergyStorageProcess a owl:Class ;
    rdfs:label "Energy Storage Process"@en ;
    rdfs:subClassOf :EnergyProcess ;
    skos:example "Storing electrical energy in a lithium-ion battery, compressing hydrogen for later fuel cell usage, pumping water into a reservoir for pumped hydro storage." ;
    iof-av:naturalLanguageDefinition "An energy process where energy is stored in a medium for later retrieval and use, following a specified protocol."@en .

:EnergyTransmissionProcess a owl:Class ;
    rdfs:label "Energy Transmission Process"@en ;
    rdfs:subClassOf :EnergyProcess ;
    skos:example "The transmission of electricity through high-voltage power lines, the transportation of natural gas through pipelines, the wireless transfer of energy via inductive charging systems." ;
    iof-av:naturalLanguageDefinition "An energy process where energy is transported from one location to another through an infrastructure designed for energy transfer."@en .

:FuelChargerRole a owl:Class ;
    rdfs:label "Fuel Charger Role"@en ;
    rdfs:subClassOf :EnergyChargerRole ;
    iof-av:naturalLanguageDefinition "An energy charger role held by a device that supplies fuel."@en .

:GHGSinkRole a owl:Class ;
    rdfs:label "GHG sink role"@en ;
    rdfs:subClassOf obo:BFO_0000023 ;
    iof-av:naturalLanguageDefinition "A role held by a material entity that removes greenhouse gas from the atmosphere."@en .

:GHGSource a owl:Class ;
    rdfs:label "GHG source"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty iof:hasRole ;
                        owl:someValuesFrom :GHGSourceRole ] ) ] ;
    iof-av:naturalLanguageDefinition "An entity that releases one or more greenhouse gases into the atmosphere. GHG sources may be natural or anthropogenic, and are typically associated with emission processes."@en ;
    iof-av:synonym "GHG emitter" .

:GHGSourceRole a owl:Class ;
    rdfs:label "GHG source role"@en ;
    rdfs:subClassOf obo:BFO_0000023 ;
    iof-av:naturalLanguageDefinition "A role held by a material entity that releases greenhouse gas into the atmosphere."@en .

:GeometricalQuality a owl:Class ;
    rdfs:label "Geometrical Quality"@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    iof-av:naturalLanguageDefinition "A quality pertaining to the shape, size or spatial extent of an entity."@en .

:LoadFactor a owl:Class ;
    rdfs:label "Load Factor"@en ;
    rdfs:subClassOf iof:MeasuredValueExpression ;
    iof-av:naturalLanguageDefinition "A measured value expression of the ratio between the occupancy of a vehicle run and its capacity, between 0 and 1."@en .

:LocationBased a owl:NamedIndividual,
        :EmissionFactorBasis ;
    rdfs:label "location-based"@en .

:MaritimeMode a owl:NamedIndividual,
        :TransportMode ;
    rdfs:label "maritime mode"@en .

:MarketBased a owl:NamedIndividual,
        :EmissionFactorBasis ;
    rdfs:label "market-based"@en .

:MassAmount a owl:Class ;
    rdfs:label "Mass Amount"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasMeasurementUnit ;
            owl:someValuesFrom qudt:Unit ],
        iof:ValueExpression ;
    iof-av:naturalLanguageDefinition "A value expression of a mass, with a numerical value and a unit such as kilogram or tonne."@en .

:Occupancy a owl:Class ;
    rdfs:label "Occupancy"@en ;
    rdfs:subClassOf iof:MeasuredValueExpression ;
    iof-av:naturalLanguageDefinition "A measured value expression of how much of a vehicle run's capacity is in use: a count of passengers aboard, or the mass or volume of payload loaded."@en .

:Order a owl:Class ;
    rdfs:label "Order"@en ;
    rdfs:subClassOf iof:Agreement ;
    iof-av:naturalLanguageDefinition "An agreement by which a party requests goods or transport services from another party."@en .

:PayloadRole a owl:Class ;
    rdfs:label "Payload Role"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:roleOf ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:BFO_0000040 [ a owl:Class ;
                                owl:complementOf iof:Person ] ) ] ],
        :TransportRole ;
    skos:example "A shipping container on a cargo ship, a package in a delivery truck, bulk goods in a freight train." ;
    iof-av:naturalLanguageDefinition "A role associated with non-human cargo being transported.e"@en .

:PhysicalQuality a owl:Class ;
    rdfs:label "Physical Quality"@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    iof-av:naturalLanguageDefinition "A quality pertaining to a physical magnitude of an entity, e.g. its mass."@en .

:RailMode a owl:NamedIndividual,
        :TransportMode ;
    rdfs:label "rail mode"@en .

:RoadMode a owl:NamedIndividual,
        :TransportMode ;
    rdfs:label "road mode"@en .

:Scope1 a owl:NamedIndividual,
        :GHGProtocolScope ;
    rdfs:label "scope 1"@en ;
    iof-av:naturalLanguageDefinition """Scope 1 includes all direct emissions that are generated from sources that are directly owned or controlled by an organisation. These include the use of natural gas at local or international sites, using liquid fuels to run a fleet of owned vehicles, or gases leaking from air-conditioning and refrigeration units.  \r\r\r\r
\r\r\r\r
Source: https://www.compareyourfootprint.com/difference-scope-1-2-3-emissions/"""@en .

:Scope2 a owl:NamedIndividual,
        :GHGProtocolScope ;
    rdfs:label "scope 2"@en ;
    iof-av:naturalLanguageDefinition """Scope 2 includes all indirect emissions from the generation of the electricity purchased and used by an organisation at local or international sites. These emissions can be measured as location-based or market-based. \r\r\r\r
\r\r\r\r
Source: https://www.compareyourfootprint.com/difference-scope-1-2-3-emissions/"""@en .

:Scope3 a owl:NamedIndividual,
        :GHGProtocolScope ;
    rdfs:label "scope 3"@en ;
    iof-av:naturalLanguageDefinition """Scope 3 includes all indirect emissions that occur in an organisation’s value chain – so activities that they do not own or control. These are usually the greatest share of an organisation’s carbon footprint, covering emissions associated with the following 15 categories. There are also additional categories you can measure, such as home working emissions.  \r\r\r\r
\r\r\r\r
Source: https://www.compareyourfootprint.com/difference-scope-1-2-3-emissions/"""@en .

:ShipperRole a owl:Class ;
    rdfs:label "Shipper Role"@en ;
    rdfs:subClassOf iof:CustomerRole ;
    iof-av:naturalLanguageDefinition "A customer role held by the party that consigns payload to a carrier for transport."@en .

:StopCall a owl:Class ;
    rdfs:label "Stop Call"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000132 ;
            owl:someValuesFrom :VehicleRun ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000066 ;
            owl:someValuesFrom :Stop ],
        obo:BFO_0000015 ;
    iof-av:naturalLanguageDefinition "The process, part of a vehicle run, of the vehicle dwelling at one stop: from arrival (starts at time instance) to departure (ends at time instance). Passengers board and alight and consignments are loaded and unloaded during a stop call."@en .

:Tariff a owl:Class ;
    rdfs:label "Tariff"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasMonetaryAmount ;
            owl:someValuesFrom :MonetaryAmount ],
        iof:InformationContentEntity ;
    iof-av:naturalLanguageDefinition "An information content entity that prescribes the price of a transport service under given conditions: a passenger fare or a freight rate."@en .

:TransportDocument a owl:Class ;
    rdfs:label "Transport Document"@en ;
    rdfs:subClassOf iof:InformationContentEntity ;
    iof-av:naturalLanguageDefinition "An information content entity that accompanies or evidences a transport: a ticket, a waybill, a bill of lading, a proof of delivery, a customs declaration."@en .

:TransportEmissionDesignSpecification a owl:Class ;
    rdfs:label "TransportEmissionDesignSpecification"@en ;
    rdfs:subClassOf :TransportDesignSpecification ;
    iof-av:naturalLanguageDefinition "A TransportEmissionDesignSpecification is a transport design specification that prescribes emission amounts and limits for a transport system or vehicle, potentially contains also control measure, or related environmental impact  ."@en .

:TransportFuelDesignSpecification a owl:Class ;
    rdfs:label "TransportFuelDesignSpecification"@en ;
    rdfs:comment "It could specify fuel types (e.g., diesel, electric, hydrogen), fuel efficiency, average consumption."@en ;
    rdfs:subClassOf :TransportDesignSpecification ;
    iof-av:naturalLanguageDefinition "A TransportFuelDesignSpecification is a transport design specification that prescribes the type, characteristics, or usage parameters of fuel in a transport system or vehicle."@en .

:TransportSpeedDesignSpecification a owl:Class ;
    rdfs:label "TransportSpeedDesignSpecification"@en ;
    rdfs:subClassOf :TransportDesignSpecification ;
    iof-av:naturalLanguageDefinition "A TransportSpeedDesignSpecification is a transport design specification that prescribes speed constraints, performance envelopes, or operational velocity guidelines for a transport system or vehicle."@en .

:TransportStatus a owl:Class ;
    rdfs:label "Transport Status"@en ;
    rdfs:subClassOf iof:ValueExpression ;
    iof-av:naturalLanguageDefinition "A value expression that classifies the current state of a movement or of what it carries, for track and trace: booked, collected, in transit, delivered, cancelled. The freight and passenger modules provide the individuals."@en .

:TransportWork a owl:Class ;
    rdfs:label "Transport Work"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasMeasurementUnit ;
            owl:someValuesFrom qudt:Unit ],
        iof:MeasuredValueExpression ;
    iof-av:naturalLanguageDefinition "A measured value expression of the transport performed by a movement: tonne-kilometres for freight or passenger-kilometres for people. The usual denominator for emission intensity."@en .

:VolumeAmount a owl:Class ;
    rdfs:label "Volume Amount"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasMeasurementUnit ;
            owl:someValuesFrom qudt:Unit ],
        iof:ValueExpression ;
    iof-av:naturalLanguageDefinition "A value expression of a volume, with a numerical value and a unit such as cubic metre."@en .

:books a owl:ObjectProperty ;
    rdfs:label "books"@en ;
    rdfs:domain :Booking ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :TransportService :VehicleRun ) ] ;
    iof-av:naturalLanguageDefinition "Relates a booking to the transport service or vehicle run on which capacity is reserved."@en .

:carries a owl:ObjectProperty ;
    rdfs:label "carries"@en ;
    rdfs:domain :VehicleRun ;
    rdfs:range :TravelLeg ;
    rdfs:subPropertyOf obo:BFO_0000117 ;
    iof-av:naturalLanguageDefinition "Relates a vehicle run to a passenger or consignment travel leg that is an occurrent part of it. Inverse of carried by."@en .

:disrupts a owl:ObjectProperty ;
    rdfs:label "disrupts"@en ;
    rdfs:domain :Disruption ;
    rdfs:range :Movement ;
    iof-av:naturalLanguageDefinition "Relates a disruption to the movement it affects."@en .

:drivenBy a owl:ObjectProperty ;
    rdfs:label "driven By"@en ;
    rdfs:domain :HumanDrivenVehicle ;
    rdfs:range iof:Person ;
    iof-av:naturalLanguageDefinition "Relates a human-driven vehicle to the person who controls it. Inverse of drives."@en .

:endsAtTimeInstance a owl:DatatypeProperty ;
    rdfs:label "ends At Time Instance"@en ;
    rdfs:comment "This is to provide a shortcut to the IOF time expression. May add equivalent to that later" ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range xsd:dateTimeStamp ;
    iof-av:naturalLanguageDefinition "The time stamp at which a process ends."@en .

:followsTravelLeg a owl:ObjectProperty ;
    rdfs:label "follows travel leg"@en ;
    rdfs:domain :Transshipment ;
    rdfs:range :TravelLeg ;
    iof-av:naturalLanguageDefinition "Relates a transshipment to the travel leg that delivered the payload to the transfer node."@en .

:hasCurrency a owl:ObjectProperty ;
    rdfs:label "has currency"@en ;
    rdfs:domain :MonetaryAmount ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf :hasMeasurementUnit ;
    iof-av:naturalLanguageDefinition "Relates a monetary amount to its currency, a QUDT currency unit."@en .

:hasEmissionFactorBasis a owl:ObjectProperty ;
    rdfs:label "has emission factor basis"@en ;
    rdfs:domain iof:ValueExpression ;
    rdfs:range :EmissionFactorBasis ;
    rdfs:subPropertyOf iof:hasValueExpressionAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates an emission factor, or a value derived with one such as an emission mass, to its basis: location-based or market-based."@en .

:hasEnergyAmount a owl:ObjectProperty ;
    rdfs:label "has energy amount"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( obo:BFO_0000015 obo:BFO_0000040 ) ] ;
    rdfs:range :EnergyAmount ;
    rdfs:subPropertyOf iof:hasValueExpressionAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates a process or material entity to an energy amount that quantifies the energy it consumes, delivers or contains."@en .

:hasGHGProtocolScope a owl:ObjectProperty ;
    rdfs:label "has GHG Protocol scope"@en ;
    rdfs:domain :EmissionScopeAssignment ;
    rdfs:range :GHGProtocolScope ;
    rdfs:subPropertyOf iof:hasValueExpressionAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates an emission scope assignment to the scope it assigns."@en .

:hasMonetaryAmount a owl:ObjectProperty ;
    rdfs:label "has monetary amount"@en ;
    rdfs:range :MonetaryAmount ;
    rdfs:subPropertyOf iof:hasValueExpressionAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates a tariff, booking, document or process to a monetary amount: a price, a cost, a charge."@en .

:hasReportingOrganization a owl:ObjectProperty ;
    rdfs:label "has reporting organization"@en ;
    rdfs:domain :EmissionScopeAssignment ;
    rdfs:range iof:Organization ;
    iof-av:naturalLanguageDefinition "Relates an emission scope assignment to the organisation from whose point of view the scope is assigned."@en .

:hasTravelLeg a owl:ObjectProperty ;
    rdfs:label "has travel leg"@en ;
    rdfs:domain :Journey ;
    rdfs:range :TravelLeg ;
    rdfs:subPropertyOf obo:BFO_0000117 ;
    owl:inverseOf :travelLegOf ;
    iof-av:naturalLanguageDefinition "Relates a journey to a travel leg that is an occurrent part of it."@en .

:isSubstanceOf a owl:ObjectProperty ;
    rdfs:label "is Substance Of"@en ;
    rdfs:subPropertyOf obo:BFO_0000176 ;
    iof-av:naturalLanguageDefinition "Relates a substance to the material entity it is part of. Inverse of has substance."@en .

:isVehicleInMovement a owl:ObjectProperty ;
    rdfs:label "is Vehicle In Movement"@en ;
    rdfs:domain :Vehicle ;
    rdfs:range :Movement ;
    rdfs:subPropertyOf :participatesInMovement ;
    iof-av:naturalLanguageDefinition "Relates a vehicle to a movement it operates. Inverse of operated by vehicle."@en .

:offeredBy a owl:ObjectProperty ;
    rdfs:label "offered by"@en ;
    rdfs:domain :TransportService ;
    rdfs:range :TransportOperator ;
    iof-av:naturalLanguageDefinition "Relates a transport service to the operator that offers it."@en .

:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned By"@en ;
    rdfs:domain obo:BFO_0000040 ;
    rdfs:range iof:Agent ;
    iof-av:naturalLanguageDefinition "Relates a material entity to the person or organization that owns it. Inverse of owns."@en .

:passesBy a owl:ObjectProperty ;
    rdfs:label "passes By"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Movement :Route ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :Location :Infrastructure ) ] ;
    iof-av:naturalLanguageDefinition "Relates a movement or a route to an intermediate location or infrastructure it passes through."@en .

:precedesTravelLeg a owl:ObjectProperty ;
    rdfs:label "precedes travel leg"@en ;
    rdfs:domain :Transshipment ;
    rdfs:range :TravelLeg ;
    iof-av:naturalLanguageDefinition "Relates a transshipment to the travel leg that carries the payload onward from the transfer node."@en .

:startsAtTimeInstance a owl:DatatypeProperty ;
    rdfs:label "starts At Time Instance"@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range xsd:dateTimeStamp ;
    iof-av:naturalLanguageDefinition "The time stamp at which a process starts."@en .

:suppliedBy a owl:ObjectProperty ;
    rdfs:label "supplied by"@en ;
    rdfs:domain :ElectricitySupply ;
    rdfs:range :EnergyCharger ;
    rdfs:subPropertyOf obo:BFO_0000057 ;
    iof-av:naturalLanguageDefinition "Relates an electricity supply process to the charger through which the charge is delivered."@en .

:transfersPayload a owl:ObjectProperty ;
    rdfs:label "transfers payload"@en ;
    rdfs:domain :Transshipment ;
    rdfs:range :Payload ;
    rdfs:subPropertyOf obo:BFO_0000057 ;
    iof-av:naturalLanguageDefinition "Relates a transshipment to the payload it moves between vehicles."@en .

:travelLegOf a owl:ObjectProperty ;
    rdfs:label "travel leg of"@en ;
    rdfs:subPropertyOf obo:BFO_0000132 ;
    iof-av:naturalLanguageDefinition "Relates a travel leg to the journey it is part of."@en .

:ArtifactIdentifier a owl:Class ;
    rdfs:label "Artifact Identifier"@en ;
    rdfs:subClassOf iof:Identifier ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( iof:Identifier [ a owl:Restriction ;
                        owl:onProperty iof:designates ;
                        owl:someValuesFrom iof:MaterialArtifact ] ) ] ;
    iof-av:naturalLanguageDefinition "An identifier that designates a material artifact."@en .

:Booking a owl:Class ;
    rdfs:label "Booking"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :books ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :TransportService :VehicleRun ) ] ],
        iof:Agreement ;
    iof-av:naturalLanguageDefinition "An agreement that reserves capacity on a transport service or a vehicle run for a passenger or a consignment."@en .

:EmissionScopeAssignment a owl:Class ;
    rdfs:label "Emission Scope Assignment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iof:Organization ;
            owl:onProperty :hasReportingOrganization ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty iof:isAbout ;
            owl:someValuesFrom :EmissionProcess ],
        [ a owl:Restriction ;
            owl:onClass :GHGProtocolScope ;
            owl:onProperty :hasGHGProtocolScope ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iof:InformationContentEntity ;
    iof-av:naturalLanguageDefinition "An information content entity that assigns a GHG Protocol scope to an emission process from the point of view of one reporting organisation."@en .

:EnergyAmount a owl:Class ;
    rdfs:label "Energy Amount"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasMeasurementUnit ;
            owl:someValuesFrom qudt:Unit ],
        iof:ValueExpression ;
    iof-av:naturalLanguageDefinition "A value expression of a quantity of energy, with a numerical value and a measurement unit such as kilowatt-hour or megajoule. Used for the energy consumed by a travel leg, delivered by a charging process or stored in a fuel."@en .

:EnergySupplyStation a owl:Class ;
    rdfs:label "Energy Supply Station"@en ;
    rdfs:subClassOf :Infrastructure ;
    iof-av:naturalLanguageDefinition "Infrastructure at which vehicles are supplied with energy, by charging or by fuelling."@en .

:EnergyTransferRole a owl:Class ;
    rdfs:label "Energy Role"@en ;
    rdfs:subClassOf obo:BFO_0000023 ;
    iof-av:naturalLanguageDefinition "A role associated with the transfer, storage or conversion of energy within a system or between systems."@en .

:FuelDispenser a owl:Class ;
    rdfs:label "Fuel Adder"@en ;
    rdfs:subClassOf :EnergyCharger ;
    iof-av:naturalLanguageDefinition "An energy charger that transfers fuel from a storage source into the tank of a fuel-consuming device or vehicle, e.g. a fuel pump."@en .

:Gas a owl:Class ;
    rdfs:label "Gas"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    iof-av:naturalLanguageDefinition "A compressible material entity that exists in the gaseous state at standard temperature and pressure, and may consist of a pure substance or a mixture of gases."@en .

:GroupOfArtifacts a owl:Class ;
    rdfs:label "Group Of Artifacts"@en ;
    rdfs:subClassOf obo:BFO_0000027 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000027 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000115 ;
                        owl:someValuesFrom iof:MaterialArtifact ] [ a owl:Restriction ;
                        owl:allValuesFrom iof:MaterialArtifact ;
                        owl:onProperty obo:BFO_0000115 ] ) ] ;
    iof-av:naturalLanguageDefinition "An object aggregate whose member parts are material artifacts."@en .

:HumanDrivenVehicle a owl:Class ;
    rdfs:label "Human-Driven Vehicle"@en ;
    rdfs:subClassOf :Vehicle ;
    owl:disjointWith :AutonomousVehicle ;
    iof-av:naturalLanguageDefinition "A road vehicle requiring a human operator to navigate and control its movement."@en,
        "A vehicle that requires a human operator on board to navigate and control its movement. Orthogonal to transport mode: a human-driven vehicle may be a car, a train or a ship."@en ;
    iof-av:synonym "HDVs" .

:Methane a owl:Class ;
    rdfs:label "Methane"@en ;
    rdfs:subClassOf :GreenhouseGas ;
    iof-av:naturalLanguageDefinition "A potent greenhouse gas composed of one carbon atom and four hydrogen atoms (CH₄). It is emitted during the production and transport of coal, oil, and natural gas, and from biological sources such as livestock and wetlands"@en .

:PassengerRole a owl:Class ;
    rdfs:label "Passenger Role"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:roleOf ;
            owl:someValuesFrom iof:Person ],
        :TransportRole ;
    skos:example "A bus passenger, an airline traveler." ;
    iof-av:naturalLanguageDefinition "A role assumed by an person that is transported by a vehicle but does not contribute to its operation."@en .

:Stop a owl:Class ;
    rdfs:label "Stop"@en ;
    rdfs:subClassOf :TransferNode ;
    iof-av:naturalLanguageDefinition "A transfer node at which vehicle runs of a transport service call so that passengers can board or alight or consignments can be loaded or unloaded: a bus stop, a station, a depot door, a port berth."@en .

:TransportOperator a owl:Class ;
    rdfs:label "Transport Operator"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( iof:Agent [ a owl:Restriction ;
                        owl:onProperty iof:hasRole ;
                        owl:someValuesFrom :TransportOperatorRole ] ) ] ;
    iof-av:naturalLanguageDefinition "An agent that bears a transport operator role."@en .

:TransportOperatorRole a owl:Class ;
    rdfs:label "Transport Operator Role"@en ;
    rdfs:subClassOf iof:ServiceProviderRole ;
    iof-av:naturalLanguageDefinition "A service provider role held by an organization or person that operates vehicle runs or transport services. The carrier role is the special case of operating on behalf of a shipper."@en .

:WalkingMode a owl:NamedIndividual,
        :TransportMode ;
    rdfs:label "walking mode"@en .

:hasEmission a owl:ObjectProperty ;
    rdfs:label "has Emission"@en ;
    rdfs:domain :EmissionProcess ;
    rdfs:range :Emission ;
    rdfs:subPropertyOf :hasParticipantInEmission ;
    iof-av:naturalLanguageDefinition "Relates an emission process to the emission (the released substance) it produces."@en .

:hasEmitter a owl:ObjectProperty ;
    rdfs:label "has Emitter"@en ;
    rdfs:domain :EmissionProcess ;
    rdfs:range obo:BFO_0000040 ;
    rdfs:subPropertyOf :hasParticipantInEmission ;
    iof-av:naturalLanguageDefinition "Relates an emission process to the material entity that releases the emission, e.g. a vehicle or a power plant."@en .

:hasParticipantInEmission a owl:ObjectProperty ;
    rdfs:label "has Participant In Emission"@en ;
    rdfs:domain :EmissionProcess ;
    rdfs:range obo:BFO_0000040 ;
    rdfs:subPropertyOf obo:BFO_0000057 ;
    iof-av:naturalLanguageDefinition "Relates an emission process to a material entity that participates in it: the emitter or the emitted substance."@en .

:hasTransportMode a owl:ObjectProperty ;
    rdfs:label "has transport mode"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Vehicle :TravelLeg :Infrastructure ) ] ;
    rdfs:range :TransportMode ;
    rdfs:subPropertyOf iof:hasValueExpressionAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates a vehicle, travel leg or infrastructure to the transport mode it belongs to. A travel leg has exactly one mode; a transfer node may have several."@en .

:EnergyChargerRole a owl:Class ;
    rdfs:label "Energy Charger Role"@en ;
    rdfs:subClassOf :EnergyTransferRole ;
    iof-av:naturalLanguageDefinition "A role assigned to an entity responsible for supplying energy to another entity."@en .

:Fuel a owl:Class ;
    rdfs:label "Fuel"@en ;
    rdfs:subClassOf iof:MaterialResource ;
    iof-av:naturalLanguageDefinition "An energy carrier that is a material resource releasing energy through combustion or another chemical reaction, e.g. diesel, kerosene, hydrogen."@en .

:GreenhouseGas a owl:Class ;
    rdfs:label "GHG"@en ;
    rdfs:subClassOf :Gas ;
    iof-av:naturalLanguageDefinition "A gaseous substance that contributes to the greenhouse effect by absorbing and emitting infrared radiation in the atmosphere. Greenhouse gases play a significant role in regulating Earth’s temperature"@en ;
    iof-av:synonym "Greenhouse Gas" .

:InherentProcess a owl:Class ;
    rdfs:label "Inherent Process"@en ;
    rdfs:comment "This is a complementary notion to the \"planned process\". An inherent process is a process that happens along with the planned process, however the process itself is not planned/instructed. E.g., the gaz emission during energy consumption, the corrosion of gear during production. In many cases, it is accompnied with a main planned process."@en ;
    rdfs:subClassOf obo:BFO_0000015 ;
    iof-av:naturalLanguageDefinition "An inherent process is a process which is accompnied with a main planned process.  It  happens along with the planned process, however the process itself is not planned/instructed. E.g., the gaz emission during energy consumption, the corrosion of gear during production."@en .

:Journey a owl:Class ;
    rdfs:label "Journey"@en ;
    rdfs:seeAlso <http://ies.data.gov.uk/ontology/ies4#Journey> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasTravelLeg ;
            owl:someValuesFrom :TravelLeg ],
        :Movement ;
    iof-av:adaptedFrom "http://ies.data.gov.uk/ontology/ies4#Journey" ;
    iof-av:naturalLanguageDefinition "A movement of passengers or payload from an origin to a destination, made up of one or more travel legs. A journey with legs of different transport modes is an intermodal journey. The freight and passenger modules distinguish freight journeys of consignments from passenger journeys."@en .

:MonetaryAmount a owl:Class ;
    rdfs:label "Monetary Amount"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasCurrency ;
            owl:someValuesFrom qudt:Unit ],
        iof:ValueExpression ;
    iof-av:naturalLanguageDefinition "A value expression of a sum of money, with a numerical value and a currency as its unit (QUDT currency units, e.g. unit:GBP)."@en .

:Schedule a owl:Class ;
    rdfs:label "Schedule"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:prescribes ;
            owl:someValuesFrom :Movement ],
        iof:PlanSpecification ;
    iof-av:naturalLanguageDefinition "A plan specification that prescribes the planned start and end times of one or more movements or stop calls. A timetable and a time slot are schedules."@en .

:Transshipment a owl:Class ;
    rdfs:label "Transshipment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000066 ;
            owl:someValuesFrom :TransferNode ],
        [ a owl:Restriction ;
            owl:onProperty :transfersPayload ;
            owl:someValuesFrom :Payload ],
        [ a owl:Restriction ;
            owl:onProperty :followsTravelLeg ;
            owl:someValuesFrom :TravelLeg ],
        [ a owl:Restriction ;
            owl:onProperty :precedesTravelLeg ;
            owl:someValuesFrom :TravelLeg ],
        iof:PlannedProcess ;
    owl:disjointWith :Movement ;
    iof-av:naturalLanguageDefinition "A planned process at a transfer node in which payload or passengers are transferred from the vehicle of one travel leg to the vehicle of the next. When the two legs have different transport modes it is an intermodal transshipment."@en .

:departsAtOrigin a owl:ObjectProperty ;
    rdfs:label "departs At Origin"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Movement :Route ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :Location :Infrastructure ) ] ;
    iof-av:naturalLanguageDefinition "Relates a movement or a route to the location or infrastructure at which it starts."@en .

:endsAtDestination a owl:ObjectProperty ;
    rdfs:label "ends At Destination"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Movement :Route ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :Location :Infrastructure ) ] ;
    iof-av:naturalLanguageDefinition "Relates a movement or a route to the location or infrastructure at which it ends."@en .

:hasMeasuredDimensionValueAtSomeTime a owl:ObjectProperty ;
    rdfs:label "has Measured Dimension Value At Some Time"@en ;
    rdfs:subPropertyOf iof:hasMeasuredValueAtSomeTime ;
    iof-av:naturalLanguageDefinition "Relates an entity to a value expression of a measured dimension, e.g. length or weight."@en .

:hasParticipantsInMovement a owl:ObjectProperty ;
    rdfs:label "has Participants In Movement"@en ;
    rdfs:domain :Movement ;
    rdfs:subPropertyOf obo:BFO_0000057 ;
    owl:inverseOf :participatesInMovement ;
    iof-av:naturalLanguageDefinition "Relates a movement to a material entity that participates in it: vehicle, driver, passengers, payload."@en .

:hasSubstance a owl:ObjectProperty ;
    rdfs:label "has Substance"@en ;
    rdfs:subPropertyOf obo:BFO_0000178 ;
    owl:inverseOf :isSubstanceOf ;
    iof-av:naturalLanguageDefinition "Relates a material entity to a substance that is a continuant part of it, e.g. an emission to the gas it consists of."@en .

:operatedByVehicle a owl:ObjectProperty ;
    rdfs:label "operated By Vehicle"@en ;
    rdfs:comment "put under hasParticipant" ;
    rdfs:domain :Movement ;
    rdfs:range :Vehicle ;
    rdfs:subPropertyOf :hasParticipantsInMovement ;
    owl:inverseOf :isVehicleInMovement ;
    iof-av:naturalLanguageDefinition "Relates a movement to the vehicle that performs it. A travel leg is operated by exactly one vehicle."@en .

:participatesInMovement a owl:ObjectProperty ;
    rdfs:label "participates In Movement"@en ;
    rdfs:range :Movement ;
    rdfs:subPropertyOf obo:BFO_0000056 ;
    iof-av:naturalLanguageDefinition "Relates a material entity to a movement it participates in. Inverse of has participants in movement."@en .

:Disruption a owl:Class ;
    rdfs:label "Disruption"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :disrupts ;
            owl:someValuesFrom :Movement ],
        :InherentProcess ;
    iof-av:naturalLanguageDefinition "An unplanned process that prevents a movement from following its schedule or route."@en .

:Emission a owl:Class ;
    rdfs:label "Emission"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:hasValueExpressionAtSomeTime ;
            owl:someValuesFrom iof:ValueExpression ],
        :MaterialResidual ;
    iof-av:naturalLanguageDefinition "A material residual, gaseous or particulate, released into the environment by an emission process."@en .

:EmissionFactorBasis a owl:Class ;
    rdfs:label "Emission Factor Basis"@en ;
    rdfs:subClassOf iof:ValueExpression ;
    iof-av:naturalLanguageDefinition "A value expression stating how an emission factor was derived: location-based (average of the grid the energy was drawn from) or market-based (the contracted supply, e.g. a wind power purchase agreement)."@en .

:EnergyCarrier a owl:Class ;
    rdfs:label "Energy Carrier"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( :Fuel :ElectricitySupply ) ] ;
    iof-av:naturalLanguageDefinition "Either a fuel (a material resource that stores chemical energy) or an electricity supply (a process in which electric charge flows to a device). Defined as the union of the two because a vehicle applies one or the other; the quantity of energy involved is expressed separately as an energy amount."@en .

:EnergyProcess a owl:Class ;
    rdfs:label "Energy Process"@en ;
    rdfs:subClassOf iof:PlannedProcess ;
    iof-av:naturalLanguageDefinition "A planned process related to the generation, conversion, transfer, storage, or utilization of energy according to a predefined protocol."@en .

:MaterialResidual a owl:Class ;
    rdfs:label "Material Residual"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    iof-av:naturalLanguageDefinition "A general term for any residuals, emissions or unintended outputs from a production or delivery process. Applicable in industrial, manufacturing, supply chain and other modelling contexts."@en .

:Route a owl:Class ;
    rdfs:label "Route"@en ;
    rdfs:comment "Route is to describe a possible solution from starting point a to end point b. There can be multiple routes from a to b, each one of them has different travel legs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:prescribes ;
            owl:someValuesFrom :Journey ],
        [ a owl:Restriction ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( :Location :Infrastructure ) ] ;
            owl:onProperty :departsAtOrigin ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( :Location :Infrastructure ) ] ;
            owl:onProperty :endsAtDestination ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iof:PlanSpecification ;
    skos:example "Adam goes from home to school by foot, he can also go to school by bike or car. Each of them is one route with a single travel leg."@en ;
    iof-av:naturalLanguageDefinition "A plan specification that prescribes a journey as a sequence of route segments from an origin to a destination. A route is realised when a journey follows it."@en,
        "A realizable entity describing a possible solution for traveling from a starting point (A) to an endpoint (B). The realization of a route occurs when a traveler follows a specific sequence of movements (or travel legs), which is influenced by the physical environment and available transport options."@en .

:TransferNode a owl:Class ;
    rdfs:label "Correspondence"@en ;
    rdfs:subClassOf :Infrastructure ;
    iof-av:naturalLanguageDefinition "A Correspondence is a object that functions as a break point or pause location in a journey. Example: bus stop, highway rest zone, charging station"@en,
        "Infrastructure at which travel legs begin, end or connect and where payload or passengers can be transferred between vehicles, e.g. a bus stop, a station, a port. Replaces the earlier class Correspondence."@en .

:TransportRole a owl:Class ;
    rdfs:label "Transport Role"@en ;
    rdfs:comment "This is created to annotate person and goods in transit"@en ;
    rdfs:subClassOf obo:BFO_0000023 ;
    iof-av:naturalLanguageDefinition "A role associated with entities participating in the movement of goods, people, or other materials."@en .

:appliesEnergy a owl:ObjectProperty ;
    rdfs:label "applies Energy"@en ;
    rdfs:domain :Device ;
    rdfs:range :EnergyCarrier ;
    iof-av:naturalLanguageDefinition "Relates a device to the energy carrier it consumes (uses energy) or delivers (charges energy): a fuel it burns or holds, or an electricity supply it participates in."@en .

:EmissionProcess a owl:Class ;
    rdfs:label "Emission Process"@en ;
    rdfs:comment "The emission is not the goal of the main planned process such as production, but it inherently occurs alongside it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasEmission ;
            owl:someValuesFrom :Emission ],
        [ a owl:Restriction ;
            owl:onProperty :hasEmitter ;
            owl:someValuesFrom obo:BFO_0000040 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000117 ;
            owl:someValuesFrom :EmissionUnitProcess ],
        :InherentProcess ;
    iof-av:naturalLanguageDefinition "A process in which gases or particles are released into the environment as a byproduct of a planned activity, such as energy consumption, chemical reaction, or combustion."@en .

:GHGProtocolScope a owl:Class ;
    rdfs:label "GHG Protocol Scope"@en ;
    rdfs:subClassOf iof:ValueExpression ;
    iof-av:naturalLanguageDefinition "A value expression that classifies an emission, relative to a reporting organisation, as scope 1, 2 or 3 of the Greenhouse Gas Protocol. Scope is not an intrinsic kind of emission process: the same combustion is scope 1 for the carrier and scope 3 for the shipper."@en .

:GreenhouseGasEmission a owl:Class ;
    rdfs:label "GHG Emission"@en ;
    rdfs:subClassOf :Emission ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Emission [ a owl:Restriction ;
                        owl:onProperty :hasSubstance ;
                        owl:someValuesFrom :GreenhouseGas ] ) ] ;
    iof-av:naturalLanguageDefinition "A gaseous residual emitted as a result of industrial or biological processes, which contributes to the greenhouse effect and global warming. Common examples include carbon dioxide, methane, and nitrous oxide."@en ;
    iof-av:synonym "GHG",
        "Greenhouse Gas Emission" .

:Payload a owl:Class ;
    rdfs:label "Payload"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty iof:hasRole ;
                        owl:someValuesFrom :PayloadRole ] ) ] ;
    iof-av:naturalLanguageDefinition "A material entity that bears a payload role, i.e. goods or other non-human cargo being transported."@en .

:TransportService a owl:Class ;
    rdfs:label "Transport Service"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :offeredBy ;
            owl:someValuesFrom :TransportOperator ],
        iof:CommercialServiceSpecification ;
    iof-av:naturalLanguageDefinition "A commercial service specification that describes a transport offering of an operator: a bus line with its stops and timetable, a freight service between two terminals, a ride-hailing offer. Vehicle runs are the realisations of a transport service."@en .

:Device a owl:Class ;
    rdfs:label "Device"@en ;
    rdfs:seeAlso <http://ies.data.gov.uk/ontology/ies4#Device> ;
    rdfs:subClassOf iof:Assembly ;
    iof-av:adaptedFrom "http://ies.data.gov.uk/ontology/ies4#Device" ;
    iof-av:naturalLanguageDefinition "A man-made material artifact that performs one or more functions."@en .

:TransportDesignSpecification a owl:Class ;
    rdfs:label "Transport Design Specification"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:hasValueExpressionAtSomeTime ;
            owl:someValuesFrom iof:ValueExpression ],
        iof:DesignSpecification ;
    iof-av:naturalLanguageDefinition "A TransportDesignSpecification is a design specification that prescribes transport systems or vehicles."@en .

:ElectricitySupply a owl:Class ;
    rdfs:label "Electricity"@en,
        "Electricity Supply"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasEnergyAmount ;
            owl:someValuesFrom :EnergyAmount ],
        obo:BFO_0000015 ;
    iof-av:naturalLanguageDefinition "A process in which electric charge flows through a conductor from a source, usually via an energy charger, to a device or vehicle, delivering an amount of energy. Replaces the earlier class Electricity, which modelled electricity as a material resource; a supply episode (e.g. the 30 kWh delivered at one charging session) is a process, not a portion of matter."@en .

:TransportMode a owl:Class ;
    rdfs:label "Transport Mode"@en ;
    rdfs:subClassOf iof:ValueExpression ;
    iof-av:naturalLanguageDefinition "A value expression that classifies a vehicle, travel leg or piece of infrastructure by the medium it moves on or serves: road, rail, air, water (maritime), or walking for legs on foot."@en .

:hasMeasurementUnit a owl:ObjectProperty ;
    rdfs:label "has measurement unit"@en ;
    rdfs:domain iof:ValueExpression ;
    rdfs:range qudt:Unit ;
    rdfs:seeAlso qudt:unit ;
    iof-av:naturalLanguageDefinition "Relates a value expression to the QUDT unit in which its numerical value is expressed. Replaces the string property hasUnit."@en .

:ChargerDesignSpecification a owl:Class ;
    rdfs:label "Charger Design Specification"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:hasValueExpressionAtSomeTime ;
            owl:someValuesFrom iof:ValueExpression ],
        iof:DesignSpecification ;
    iof-av:naturalLanguageDefinition "A design specification that prescribes an electrical or mechanical characteristic of an energy charger. Replaces the earlier Designed* function classes, whose definitions described specification values rather than functions."@en .

:EnergyCharger a owl:Class ;
    rdfs:label "Energy Charger"@en ;
    rdfs:comment "Energy charger is a device that provides energy to another devices, and charge them if they have a chargable battery"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof:prescribedBy ;
            owl:someValuesFrom :ChargerDesignSpecification ],
        :Device ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Device [ a owl:Restriction ;
                        owl:onProperty iof:hasFunction ;
                        owl:someValuesFrom :DesignedChargerFunction ] ) ] ;
    iof-av:naturalLanguageDefinition "A device designed to transfer energy from a source to an energy storage system or consuming device, prescribed by charger design specifications (current, voltage, power, connector, protocol)."@en .

qudt:Unit a owl:Class ;
    rdfs:label "Unit (QUDT)"@en ;
    rdfs:comment "Declared here so that QUDT unit individuals (http://qudt.org/vocab/unit/, e.g. unit:KiloW-HR, unit:KiloGM, unit:KiloM) can be used without importing the full QUDT ontology."@en ;
    rdfs:isDefinedBy qudt: .

:VehicleRun a owl:Class ;
    rdfs:label "Vehicle Run"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :operatedByVehicle ;
            owl:someValuesFrom :Vehicle ],
        :TravelLeg ;
    iof-av:naturalLanguageDefinition "A travel leg that is the movement of one vehicle from an origin to a destination, possibly calling at intermediate stops, and that carries the travel legs of the passengers or consignments aboard. A bus run on a line, a truck round, a train service between two stations and a flight are vehicle runs. The passengers' and consignments' own legs are occurrent parts of the run (carried by it)."@en .

:Location a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:seeAlso <http://ies.data.gov.uk/ontology/ies4#Location> ;
    rdfs:subClassOf obo:BFO_0000029 ;
    iof-av:adaptedFrom "http://ies.data.gov.uk/ontology/ies4#Location" ;
    iof-av:naturalLanguageDefinition "A site that is a geographic place specifying a point or an area on the Earth's surface or elsewhere."@en .

:TravelLeg a owl:Class ;
    rdfs:label "Travel Leg"@en ;
    rdfs:comment """A Journey/Transit can consist of multiple travel legs. \r\r\r\r
E.g., you go from home to departure airport by car, then take the plane, then from arrival airport to the hotel by taxi. It is one journey with three legs of travel.\r\r\r\r
\r\r\r\r
TravelLeg is also considered the minimum travel "unit" that is not dividable. Inside a optimal  travelLeg it is a point-to-point relation, there is no pause or switch or change of payload or passenger.\r\r\r\r
This one originates from IES4 TravelLeg"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Vehicle ;
            owl:onProperty :operatedByVehicle ],
        [ a owl:Restriction ;
            owl:onClass :TransportMode ;
            owl:onProperty :hasTransportMode ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( :Location :Infrastructure ) ] ;
            owl:onProperty :departsAtOrigin ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( :Location :Infrastructure ) ] ;
            owl:onProperty :endsAtDestination ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :startsAtTimeInstance ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :endsAtTimeInstance ],
        :Movement ;
    iof-av:naturalLanguageDefinition "A movement in exactly one transport mode, from one origin to one destination, operated by at most one vehicle (none for a pedestrian leg), with no transfer of payload or passengers in between. A travel leg is either a vehicle run (the vehicle's own movement) or the leg of a passenger or consignment carried by a vehicle run."@en ;
    iof-av:synonym "Jouney leg" .

:Infrastructure a owl:Class ;
    rdfs:label "Infrastructure"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000171 ;
            owl:someValuesFrom :Location ],
        obo:BFO_0000040 ;
    iof-av:naturalLanguageDefinition "A man-made material entity, located at some location, that provides the ways, nodes or facilities on which movements take place: roads, railways, waterways, air routes, terminals, stations."@en .

:Vehicle a owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:seeAlso <http://ies.data.gov.uk/ontology/ies4#Vehicle> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :appliesEnergy ;
            owl:someValuesFrom :EnergyCarrier ],
        :Device ;
    iof-av:adaptedFrom "http://ies.data.gov.uk/ontology/ies4#Vehicle" ;
    iof-av:naturalLanguageDefinition "A device that is a means of transportation and applies some energy carrier to move. Mode modules add road vehicles, rail vehicles, aircraft and ships."@en .

:Movement a owl:Class ;
    rdfs:label "Movement"@en ;
    rdfs:seeAlso <http://ies.data.gov.uk/ontology/ies4#Movement> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :departsAtOrigin ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Location :Infrastructure ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :endsAtDestination ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :Location :Infrastructure ) ] ],
        [ a owl:Restriction ;
            owl:onProperty :hasParticipantsInMovement ;
            owl:someValuesFrom obo:BFO_0000040 ],
        iof:PlannedProcess ;
    iof-av:adaptedFrom "http://ies.data.gov.uk/ontology/ies4#Movement" ;
    iof-av:naturalLanguageDefinition "A planned process in which a material entity moves from one location to another."@en .

[] a owl:AllDifferent ;
    owl:distinctMembers ( :Scope1 :Scope2 :Scope3 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( obo:BFO_0000024 obo:BFO_0000027 obo:BFO_0000030 :Gas :MaterialResidual ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :EnergyChargingProcess :EnergyStorageProcess :EnergyTransmissionProcess ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :TransportEmissionDesignSpecification :TransportFuelDesignSpecification :TransportSpeedDesignSpecification ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( :RoadMode :RailMode :AirMode :MaritimeMode :WalkingMode ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( :LocationBased :MarketBased ) .

