@prefix : <https://www.cranfield.ac.uk/transit/maritime#> .
@prefix transit: <https://www.cranfield.ac.uk/transit/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iof: <https://spec.industrialontologies.org/ontology/core/Core/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<https://www.cranfield.ac.uk/transit/maritime> a owl:Ontology ;
    owl:versionIRI <https://www.cranfield.ac.uk/transit/maritime/2025-11> ;
    owl:versionInfo "0.4.0" ;
    owl:imports <https://www.cranfield.ac.uk/transit/core> ;
    rdfs:label "TransiT Maritime Module"@en ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:abstract "Maritime and inland waterway specialisations of the TransiT Core Ontology: ships, seaports, waterways and sailings. Every class carries the maritime transport mode."@en .

#################################################################
#    Vehicles
#################################################################

:Ship a owl:Class ;
    rdfs:subClassOf transit:Vehicle ,
        [ a owl:Restriction ; owl:onProperty transit:hasTransportMode ; owl:hasValue transit:MaritimeMode ] ;
    rdfs:label "Ship"@en ;
    iof-av:naturalLanguageDefinition "A vehicle that travels on water."@en ;
    iof-av:adaptedFrom "http://ies.data.gov.uk/ontology/ies4#Ship" ;
    rdfs:seeAlso <http://ies.data.gov.uk/ontology/ies4#Ship> .

:Ferry a owl:Class ;
    rdfs:subClassOf :Ship ;
    rdfs:label "Ferry"@en ;
    iof-av:naturalLanguageDefinition "A ship that carries passengers, and often their vehicles, on a regular service between two or more seaports."@en .

:Barge a owl:Class ;
    rdfs:subClassOf :Ship ;
    rdfs:label "Barge"@en ;
    iof-av:naturalLanguageDefinition "A flat-bottomed ship for carrying payload on inland waterways, often towed or pushed."@en .

:ContainerShip a owl:Class ;
    rdfs:subClassOf :Ship ;
    rdfs:label "Container Ship"@en ;
    iof-av:naturalLanguageDefinition "A ship designed to carry payload in standardised cargo units (containers)."@en .

[] a owl:AllDisjointClasses ; owl:members ( :Ferry :Barge :ContainerShip ) .

:ShipIdentifier a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( transit:VehicleIdentifier
        [ a owl:Restriction ; owl:onProperty iof:designates ; owl:someValuesFrom :Ship ] ) ] ;
    rdfs:subClassOf transit:VehicleIdentifier ;
    rdfs:label "Ship Identifier"@en ;
    iof-av:naturalLanguageDefinition "A vehicle identifier that designates a ship, e.g. an IMO number."@en .

#################################################################
#    Infrastructure
#################################################################

:Waterway a owl:Class ;
    rdfs:subClassOf transit:TransportWay ,
        [ a owl:Restriction ; owl:onProperty transit:hasTransportMode ; owl:hasValue transit:MaritimeMode ] ;
    rdfs:label "Waterway"@en ;
    iof-av:naturalLanguageDefinition "A transport way on water along which ships move: a shipping lane, a canal or a navigable river."@en .

:Seaport a owl:Class ;
    rdfs:subClassOf transit:Terminal ,
        [ a owl:Restriction ; owl:onProperty transit:hasTransportMode ; owl:hasValue transit:MaritimeMode ] ;
    rdfs:label "Seaport"@en ;
    iof-av:synonym "harbour port"@en ;
    iof-av:naturalLanguageDefinition "A terminal on a body of water at which ships berth and at which passengers and payload are transferred to and from ships. Replaces the earlier class HarborPort."@en .

#################################################################
#    Movements
#################################################################

:Sailing a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( transit:TravelLeg
        [ a owl:Restriction ; owl:onProperty transit:operatedByVehicle ; owl:someValuesFrom :Ship ] ) ] ;
    rdfs:subClassOf transit:TravelLeg ,
        [ a owl:Restriction ; owl:onProperty transit:hasTransportMode ; owl:hasValue transit:MaritimeMode ] ;
    rdfs:label "Sailing"@en ;
    iof-av:synonym "voyage"@en ;
    iof-av:naturalLanguageDefinition "A travel leg operated by a ship."@en ;
    iof-av:adaptedFrom "http://ies.data.gov.uk/ontology/ies4#Sailing" ;
    rdfs:seeAlso <http://ies.data.gov.uk/ontology/ies4#Sailing> .
