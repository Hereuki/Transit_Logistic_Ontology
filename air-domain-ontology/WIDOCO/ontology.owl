    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#travelsOn">
        <owl:inverseOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#carriesPassenger"/>
