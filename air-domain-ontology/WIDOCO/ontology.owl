        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
        <rdfs:comment xml:lang="en">Relates a flight to the airport it arrived at.</rdfs:comment>
        <rdfs:label xml:lang="en">arrived at</rdfs:label>
    </owl:ObjectProperty>
    


