        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CabinCrew"/>
        <rdfs:comment xml:lang="en">Relates a flight to its cabin crew.</rdfs:comment>
        <rdfs:label xml:lang="en">served by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#splitByBreakBulkProcess -->


