    <!-- http://www.cranfield.ac.uk/ontology/air-domain#regulatedBy -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#regulatedBy">
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PolicyOrRegulation"/>
