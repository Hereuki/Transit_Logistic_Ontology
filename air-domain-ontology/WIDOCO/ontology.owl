        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SafetyReport"/>
        <rdfs:comment xml:lang="en">Relates a safety incident to the safety report documenting it.</rdfs:comment>
        <rdfs:label xml:lang="en">documented in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#emitsCarbon -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#emitsCarbon">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CarbonEmission"/>
        <rdfs:comment xml:lang="en">Relates a flight to the carbon emissions it produces.</rdfs:comment>
        <rdfs:label xml:lang="en">emits carbon</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#employedBy -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#employedBy">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Person"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">Relates a person to the organization that employs them.</rdfs:comment>
