    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#handledByFreightForwarder">
        <rdfs:subPropertyOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasParty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FreightForwarder"/>
        <rdfs:comment xml:lang="en">Indicates that a freight forwarder is managing the shipment.</rdfs:comment>
        <rdfs:label xml:lang="en">handled by freight forwarder</rdfs:label>
    </owl:ObjectProperty>
    


