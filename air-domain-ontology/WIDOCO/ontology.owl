        <rdfs:label xml:lang="en">stored in storage shed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#subjectToAirworthinessDirective -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#subjectToAirworthinessDirective">
