        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:comment xml:lang="en">Relates a passenger to the flight they travel on.</rdfs:comment>
        <rdfs:label xml:lang="en">travels on</rdfs:label>
    </owl:ObjectProperty>
    


