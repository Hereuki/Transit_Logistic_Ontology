        <rdfs:label xml:lang="en">requires hazard label</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#scheduledBeforeCutTime -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#scheduledBeforeCutTime">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CutTime"/>
        <rdfs:comment xml:lang="en">Ensures cargo is processed before the airline&apos;s cut-off time.</rdfs:comment>
        <rdfs:label xml:lang="en">scheduled before cut time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#servedBy -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#servedBy">
