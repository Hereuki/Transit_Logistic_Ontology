    <!-- http://www.cranfield.ac.uk/ontology/air-domain#affectedByOperationalEvent -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#affectedByOperationalEvent">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AirportOperationsCentre"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#OperationalDisruption"/>
        <rdfs:comment xml:lang="en">Relates airport operations to an operational event affecting them.</rdfs:comment>
        <rdfs:label xml:lang="en">affected by operational event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#affectedByWeather -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#affectedByWeather">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#METAR"/>
        <rdfs:comment xml:lang="en">Relates a flight to a weather observation relevant to its conduct.</rdfs:comment>
        <rdfs:label xml:lang="en">affected by weather</rdfs:label>
    </owl:ObjectProperty>
    


