<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.cranfield.ac.uk/ontology/air-domain#"
     xml:base="http://www.cranfield.ac.uk/ontology/air-domain"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.cranfield.ac.uk/ontology/air-domain">
        <owl:versionIRI rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain/0.2.0"/>
        <dc:title xml:lang="en">Air Domain Ontology</dc:title>
        <terms:abstract xml:lang="en">An OWL 2 DL ontology of the civil air transport domain: passenger and cargo operations, airports, aircraft and airworthiness, flight operations and crew, air traffic management, ground handling, regulation, safety and security, and environmental sustainability.</terms:abstract>
        <terms:title xml:lang="en">Air Domain Ontology</terms:title>
        <vann:preferredNamespacePrefix>air</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://www.cranfield.ac.uk/ontology/air-domain#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">A comprehensive ontology of the civil air transport domain, covering air passenger and cargo/freight operations, airport infrastructure and operations, aircraft and airworthiness, flight operations and crew, air traffic management, ground handling, regulatory/certification instruments, safety and security, and environmental sustainability. Consolidated from the project&apos;s existing class/relationship tables (Air_Freight_and_Passenger_Ontology, Sheet3 organisational/regulatory layers, the cargo-handling &apos;Category&apos; breakdown, and the Airport Operations Plan / APOC concepts) and extended with generally-recognised air-domain concepts not yet captured there. No upper ontology (e.g. BFO) is imported; a small set of pragmatic top-level classes (Agent, PhysicalObject, InformationObject, Process, Location, PolicyOrRegulation, Measurement, Service, Category) organises the hierarchy instead.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Domain Ontology</rdfs:label>
        <owl:versionInfo>0.2.0</owl:versionInfo>
        <skos:changeNote xml:lang="en">0.2.0: fixed inverted/part-of subclass links (Aerodrome/Airport, AerodromeOperatingSite, ChargingPoint, Consignment); converted EASA, FAA, ICAO, IATA, CORSIA from classes to individuals; moved classifications out of Measurement into a new Category branch; added Identifier, Certificate, Licence, Occurrence, TradeAssociation, GroundVehicle; fixed IATAcode/ICAOcode range typos and over-narrow domains/ranges; added part-of, property hierarchy, inverses, functional properties, existential and cardinality restrictions, defined classes and disjointness axioms.</skos:changeNote>
    </owl:Ontology>
    


