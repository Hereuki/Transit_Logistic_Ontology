    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#forecastBy">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#TAF"/>
        <rdfs:comment xml:lang="en">Relates a flight to a terminal aerodrome forecast relevant to its conduct.</rdfs:comment>
        <rdfs:label xml:lang="en">forecast by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#goesThroughScreening -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#goesThroughScreening">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Passenger"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SecurityScreening"/>
        <rdfs:comment xml:lang="en">Relates a passenger to a security screening they go through.</rdfs:comment>
        <rdfs:label xml:lang="en">goes through screening</rdfs:label>
    </owl:ObjectProperty>
    


