        <rdfs:label xml:lang="en">provides ground handling service</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#receivesGroundHandlingService -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#receivesGroundHandlingService">
