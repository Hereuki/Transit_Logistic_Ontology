    <!-- http://www.cranfield.ac.uk/ontology/air-domain#usesICAOCode -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#usesICAOCode">
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ICAOCode"/>
        <rdfs:comment xml:lang="en">Relates an airport, airline, or aircraft to its ICAO code.</rdfs:comment>
        <rdfs:label xml:lang="en">uses ICAO code</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#usesKPI -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#usesKPI">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AirportOperationsCentre"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#KPI"/>
        <rdfs:comment xml:lang="en">Relates an airport operations centre to a KPI it uses to measure performance.</rdfs:comment>
        <rdfs:label xml:lang="en">uses KPI</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#usesRunway -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#usesRunway">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Runway"/>
        <rdfs:comment xml:lang="en">Relates a flight to the runway it uses.</rdfs:comment>
        <rdfs:label xml:lang="en">uses runway</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#usesSustainableAviationFuel -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#usesSustainableAviationFuel">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SustainableAviationFuel"/>
        <rdfs:comment xml:lang="en">Relates a flight to sustainable aviation fuel used in its operation.</rdfs:comment>
        <rdfs:label xml:lang="en">uses sustainable aviation fuel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasCO2Kg -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasCO2Kg">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CarbonEmission"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The mass of carbon dioxide emitted, in kilograms.</rdfs:comment>
        <rdfs:label xml:lang="en">has CO2 kg</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasCapacityValue -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasCapacityValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Capacity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The numeric value of a capacity measurement.</rdfs:comment>
        <rdfs:label xml:lang="en">has capacity value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasCostGBP -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasCostGBP">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightCost"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">A cost value expressed in GBP.</rdfs:comment>
        <rdfs:label xml:lang="en">has cost GBP</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasCutTimeValue -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasCutTimeValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CutTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The date and time of a cargo cut-off.</rdfs:comment>
        <rdfs:label xml:lang="en">has cut time value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasFlightNumber -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasFlightNumber">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The designator/flight number assigned to a flight.</rdfs:comment>
        <rdfs:label xml:lang="en">has flight number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasIATACodeValue -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasIATACodeValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#IATACode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The literal 3-letter IATA code value.</rdfs:comment>
        <rdfs:label xml:lang="en">has IATA code value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasICAOCodeValue -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasICAOCodeValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ICAOCode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The literal 4-character ICAO code value.</rdfs:comment>
        <rdfs:label xml:lang="en">has ICAO code value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasName -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasName">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of a person or organization.</rdfs:comment>
        <rdfs:label xml:lang="en">has name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasScheduledArrivalTime -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasScheduledArrivalTime">
        <rdfs:subPropertyOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasScheduledDateTime"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The scheduled on-block/arrival date and time of a flight.</rdfs:comment>
        <rdfs:label xml:lang="en">has scheduled arrival time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasScheduledDateTime -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasScheduledDateTime">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The scheduled date and time of a flight event.</rdfs:comment>
        <rdfs:label xml:lang="en">has scheduled date time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasScheduledDepartureTime -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasScheduledDepartureTime">
        <rdfs:subPropertyOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasScheduledDateTime"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The scheduled off-block/departure date and time of a flight.</rdfs:comment>
        <rdfs:label xml:lang="en">has scheduled departure time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasWeightKg -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasWeightKg">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Cargo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The weight of an item of cargo in kilograms.</rdfs:comment>
        <rdfs:label xml:lang="en">has weight kg</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#requiresPacking -->


    <owl:DatatypeProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#requiresPacking">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Cargo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Marks that the cargo needs packaging before transport.</rdfs:comment>
        <rdfs:label xml:lang="en">requires packing</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Accident -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Accident">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SafetyIncident"/>
        <owl:disjointWith rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SeriousIncident"/>
        <rdfs:comment xml:lang="en">An occurrence involving an aircraft resulting in death, serious injury, or significant aircraft damage.</rdfs:comment>
        <rdfs:label xml:lang="en">Accident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:comment xml:lang="en">A defined area on land or water (including any buildings, installations and equipment) intended to be used wholly or in part for the arrival, departure and surface movement of aircraft (ICAO Annex 14). Airport is a kind of aerodrome.</rdfs:comment>
        <rdfs:label xml:lang="en">Aerodrome</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AerodromeOperatingSite -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AerodromeOperatingSite">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A specific site within or associated with an aerodrome from which operations are conducted.</rdfs:comment>
        <rdfs:label xml:lang="en">Aerodrome Operating Site</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AerodromeService -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AerodromeService">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Service"/>
        <rdfs:comment xml:lang="en">A service provided at an aerodrome to support aircraft operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Aerodrome Service</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Agent -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Agent">
        <rdfs:comment xml:lang="en">An entity capable of acting within the air transport domain, either an organization or a person.</rdfs:comment>
        <rdfs:label xml:lang="en">Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirDepot -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirDepot">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:comment xml:lang="en">A ground logistics depot facility associated with air cargo operations, such as a charging or staging depot.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Depot</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirNavigationFacility -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirNavigationFacility">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:comment xml:lang="en">A facility that provides navigation aids or communication services in support of air navigation.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Navigation Facility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirNavigationServiceProvider -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirNavigationServiceProvider">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">An organization that provides air traffic management and air navigation services within a defined airspace.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Navigation Service Provider</rdfs:label>
        <skos:altLabel xml:lang="en">ANSP</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirNetwork -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirNetwork">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Location"/>
        <rdfs:comment xml:lang="en">The interconnected system of air routes, flights, and airports.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Network</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirOperatorCertificate -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirOperatorCertificate">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Certificate"/>
        <rdfs:comment xml:lang="en">A certificate issued by a competent authority confirming an operator&apos;s capability to conduct specified aircraft operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Operator Certificate</rdfs:label>
        <skos:altLabel xml:lang="en">AOC</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirShipment -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirShipment">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#TransportMode"/>
        <rdfs:comment xml:lang="en">A mode of cargo transportation using aircraft, known for speed and suitability for high-value or time-sensitive goods.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Shipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirTrafficControl -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirTrafficControl">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:comment xml:lang="en">The service provided to manage aircraft movement in airspace and on the ground at an airport, in order to prevent collisions and expedite traffic.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Traffic Control</rdfs:label>
        <skos:altLabel xml:lang="en">ATC</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirTrafficController -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirTrafficController">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#holdsLicense"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Licence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A licensed person who provides air traffic control services to manage aircraft movement in the air and on the ground.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Traffic Controller</rdfs:label>
        <skos:altLabel xml:lang="en">ATCO</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirTrafficFlowManagement -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirTrafficFlowManagement">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:comment xml:lang="en">A service that manages air traffic flow to optimise the use of available airspace and airport capacity.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Traffic Flow Management</rdfs:label>
        <skos:altLabel xml:lang="en">ATFM</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirTrafficService -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirTrafficService">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Service"/>
        <rdfs:comment xml:lang="en">A service provided to promote the safe, orderly, and expeditious flow of air traffic.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Traffic Service</rdfs:label>
        <skos:altLabel xml:lang="en">ATS</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirWarehouse -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirWarehouse">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Warehouse"/>
        <rdfs:comment xml:lang="en">A storage facility at or near an airport for freight or goods.</rdfs:comment>
        <rdfs:label xml:lang="en">Air Warehouse</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Aircraft -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Aircraft">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PhysicalObject"/>
        <rdfs:comment xml:lang="en">A vehicle capable of atmospheric flight used to transport passengers or goods.</rdfs:comment>
        <rdfs:label xml:lang="en">Aircraft</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AircraftComponent -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AircraftComponent">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PhysicalObject"/>
        <rdfs:comment xml:lang="en">A part or subsystem fitted to or carried aboard an aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Aircraft Component</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AircraftConfiguration -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AircraftConfiguration">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#InformationObject"/>
        <rdfs:comment xml:lang="en">The specific approved configuration of an aircraft, including seating layout and fitted equipment.</rdfs:comment>
        <rdfs:label xml:lang="en">Aircraft Configuration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AircraftEquipment -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AircraftEquipment">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AircraftComponent"/>
        <rdfs:comment xml:lang="en">Equipment fitted to an aircraft in accordance with its approved configuration.</rdfs:comment>
        <rdfs:label xml:lang="en">Aircraft Equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AircraftMaintenanceCheck -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AircraftMaintenanceCheck">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#MaintenanceActivity"/>
        <rdfs:comment xml:lang="en">A scheduled inspection of an aircraft carried out at defined intervals (e.g. A, B, C, or D check).</rdfs:comment>
        <rdfs:label xml:lang="en">Aircraft Maintenance Check</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AircraftManufacturer -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AircraftManufacturer">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">An organization that designs and manufactures aircraft or aircraft components.</rdfs:comment>
        <rdfs:label xml:lang="en">Aircraft Manufacturer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AircraftType -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AircraftType">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Category"/>
        <rdfs:comment xml:lang="en">The certificated type/model classification of an aircraft (e.g. Boeing 777, Airbus A320).</rdfs:comment>
        <rdfs:label xml:lang="en">Aircraft Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Airline -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Airline">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasAirOperatorCertificate"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AirOperatorCertificate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An organization providing air transport services for passengers or goods.</rdfs:comment>
        <rdfs:label xml:lang="en">Airline</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Airport -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Airport">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
        <rdfs:comment xml:lang="en">An aerodrome equipped with facilities for commercial air transport, such as passenger terminals and cargo handling.</rdfs:comment>
        <rdfs:label xml:lang="en">Airport</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirportApron -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirportApron">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The area of an airport where aircraft are parked, unloaded or loaded, refuelled, boarded, or maintained.</rdfs:comment>
        <rdfs:label xml:lang="en">Airport Apron</rdfs:label>
        <skos:altLabel xml:lang="en">Ramp</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirportOperationsCentre -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirportOperationsCentre">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:comment xml:lang="en">A centralised facility from which airport stakeholders jointly monitor and manage day-to-day airport operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Airport Operations Centre</rdfs:label>
        <skos:altLabel xml:lang="en">APOC</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirportOperator -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirportOperator">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">The organization responsible for managing and operating an airport.</rdfs:comment>
        <rdfs:label xml:lang="en">Airport Operator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirportPolicy -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirportPolicy">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PolicyOrRegulation"/>
        <rdfs:comment xml:lang="en">Rules and regulations governing operations at an airport.</rdfs:comment>
        <rdfs:label xml:lang="en">Airport Policy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Airspace -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Airspace">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Location"/>
        <rdfs:comment xml:lang="en">A defined three-dimensional portion of the atmosphere within which specific rules or air traffic services apply.</rdfs:comment>
        <rdfs:label xml:lang="en">Airspace</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirwayBill -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirwayBill">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A document that acts as a contract of carriage between the shipper and airline.</rdfs:comment>
        <rdfs:label xml:lang="en">Airway Bill</rdfs:label>
        <skos:altLabel xml:lang="en">AWB</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AirworthinessDirective -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AirworthinessDirective">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PolicyOrRegulation"/>
        <rdfs:comment xml:lang="en">A legally enforceable regulation issued by a regulatory authority to correct an unsafe condition in an aircraft product.</rdfs:comment>
        <rdfs:label xml:lang="en">Airworthiness Directive</rdfs:label>
        <skos:altLabel xml:lang="en">AD</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Approach -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Approach">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightPhase"/>
        <rdfs:comment xml:lang="en">The phase of flight in which an aircraft descends and manoeuvres to land.</rdfs:comment>
        <rdfs:label xml:lang="en">Approach</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ArrivalGate -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ArrivalGate">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Terminal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An area where passengers disembark from an aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Arrival Gate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ArrivalNotice -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ArrivalNotice">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">Notification issued by the airline or freight forwarder indicating the cargo has arrived.</rdfs:comment>
        <rdfs:label xml:lang="en">Arrival Notice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AuthorisedEconomicOperator -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AuthorisedEconomicOperator">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">A certified party recognised as having secure and compliant supply chain and customs procedures.</rdfs:comment>
        <rdfs:label xml:lang="en">Authorised Economic Operator</rdfs:label>
        <skos:altLabel xml:lang="en">AEO</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AutomaticScanning -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AutomaticScanning">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SecurityScreening"/>
        <owl:disjointWith rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ManualScanning"/>
        <rdfs:comment xml:lang="en">Automated barcode or airway bill scanning as part of screening.</rdfs:comment>
        <rdfs:label xml:lang="en">Automatic Scanning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#AviationPolicy -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#AviationPolicy">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PolicyOrRegulation"/>
        <rdfs:comment xml:lang="en">Policies and regulations that govern the safety, security, environmental standards, and operations of the aviation industry at a national or international level.</rdfs:comment>
        <rdfs:label xml:lang="en">Aviation Policy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Baggage -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Baggage">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PhysicalObject"/>
        <rdfs:comment xml:lang="en">Personal belongings of passengers transported separately.</rdfs:comment>
        <rdfs:label xml:lang="en">Baggage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#BaggageHandling -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#BaggageHandling">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#GroundHandlingService"/>
        <rdfs:comment xml:lang="en">The loading, unloading, and sorting of passenger baggage.</rdfs:comment>
        <rdfs:label xml:lang="en">Baggage Handling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Bagging -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Bagging">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingOperation"/>
        <rdfs:comment xml:lang="en">The loading of small parcels into transport bags.</rdfs:comment>
        <rdfs:label xml:lang="en">Bagging</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#BaseMaintenance -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#BaseMaintenance">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#MaintenanceActivity"/>
        <owl:disjointWith rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#LineMaintenance"/>
        <rdfs:comment xml:lang="en">More extensive scheduled maintenance performed at a maintenance base, typically involving hangar time.</rdfs:comment>
        <rdfs:label xml:lang="en">Base Maintenance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#BirdStrike -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#BirdStrike">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SafetyIncident"/>
        <rdfs:comment xml:lang="en">A collision between an aircraft and a bird or wildlife.</rdfs:comment>
        <rdfs:label xml:lang="en">Bird Strike</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#BoardingPass -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#BoardingPass">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A document provided to a passenger to access the aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Boarding Pass</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#BondedArea -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#BondedArea">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CustomsWarehouse"/>
        <rdfs:comment xml:lang="en">A secure zone authorised for storing cargo without paying duties until customs clearance.</rdfs:comment>
        <rdfs:label xml:lang="en">Bonded Area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#BreakBulk -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#BreakBulk">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingOperation"/>
        <rdfs:comment xml:lang="en">The process of deconsolidating cargo from a ULD into individual shipments at the destination.</rdfs:comment>
        <rdfs:label xml:lang="en">Break Bulk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CabinCrew -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CabinCrew">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CrewMember"/>
        <owl:disjointWith rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightCrew"/>
        <rdfs:comment xml:lang="en">Personnel responsible for passenger safety and service during a flight.</rdfs:comment>
        <rdfs:label xml:lang="en">Cabin Crew</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Capacity -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Capacity">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Measurement"/>
        <rdfs:comment xml:lang="en">The maximum throughput of an airport resource (e.g. runway, terminal, apron) in a given period.</rdfs:comment>
        <rdfs:label xml:lang="en">Capacity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CarbonEmission -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CarbonEmission">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Measurement"/>
        <rdfs:comment xml:lang="en">The amount of carbon dioxide released during a flight or logistics operation.</rdfs:comment>
        <rdfs:label xml:lang="en">Carbon Emission</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Cargo -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Cargo">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PhysicalObject"/>
        <rdfs:comment xml:lang="en">Goods or merchandise transported in an aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Cargo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CargoContainer -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CargoContainer">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Equipment"/>
        <rdfs:comment xml:lang="en">A container used to hold and transport cargo.</rdfs:comment>
        <rdfs:label xml:lang="en">Cargo Container</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingEquipment -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingEquipment">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Equipment"/>
        <rdfs:comment xml:lang="en">Equipment used to move, sort, or consolidate cargo within a handling facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Cargo Handling Equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingOperation -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingOperation">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:comment xml:lang="en">An operational activity performed on cargo within a handling facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Cargo Handling Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CargoHold -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CargoHold">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AircraftComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aircraft"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The section of an aircraft designated for carrying cargo.</rdfs:comment>
        <rdfs:label xml:lang="en">Cargo Hold</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CargoTerminal -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CargoTerminal">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:comment xml:lang="en">A dedicated facility at an airport for the handling of air cargo.</rdfs:comment>
        <rdfs:label xml:lang="en">Cargo Terminal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CargoType -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CargoType">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Category"/>
        <rdfs:comment xml:lang="en">The classification of cargo based on content and handling needs.</rdfs:comment>
        <rdfs:label xml:lang="en">Cargo Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Category -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Category">
        <rdfs:comment xml:lang="en">A classification value or kind used to categorise other entities (e.g. aircraft type, cargo type, passenger class, energy source). Categories are not measurements: they are not quantities and carry no unit.</rdfs:comment>
        <rdfs:label xml:lang="en">Category</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CateringCompany -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CateringCompany">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">A company that prepares and supplies food and beverages for flights.</rdfs:comment>
        <rdfs:label xml:lang="en">Catering Company</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CateringService -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CateringService">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#GroundHandlingService"/>
        <rdfs:comment xml:lang="en">The provision and loading of food and beverages onto an aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Catering Service</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Certificate -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Certificate">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A document issued by a competent authority attesting that an entity meets specified requirements.</rdfs:comment>
        <rdfs:label xml:lang="en">Certificate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CertificateOfAirworthiness -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CertificateOfAirworthiness">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Certificate"/>
        <rdfs:comment xml:lang="en">A certificate confirming that an aircraft conforms to its approved design and is safe for operation.</rdfs:comment>
        <rdfs:label xml:lang="en">Certificate of Airworthiness</rdfs:label>
        <skos:altLabel xml:lang="en">CofA</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ChargingPoint -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ChargingPoint">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Equipment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ChargingStation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An individual connection point at a charging station used to charge a vehicle or aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Charging Point</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ChargingStation -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ChargingStation">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:comment xml:lang="en">A facility for charging electric ground handling equipment or electric aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Charging Station</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CheckInCounter -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CheckInCounter">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Terminal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A location at an airport where passengers confirm their presence for a flight.</rdfs:comment>
        <rdfs:label xml:lang="en">Check-In Counter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CivilAviationAuthority -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CivilAviationAuthority">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#RegulatoryAuthority"/>
        <rdfs:comment xml:lang="en">A national authority responsible for civil aviation safety oversight and regulation within its state.</rdfs:comment>
        <rdfs:label xml:lang="en">Civil Aviation Authority</rdfs:label>
        <skos:altLabel xml:lang="en">CAA</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CodeShareAgreement -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CodeShareAgreement">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">An agreement under which two or more airlines share the same flight, each marketing it under its own designator code.</rdfs:comment>
        <rdfs:label xml:lang="en">Code Share Agreement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Commander -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Commander">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightCrew"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#holdsLicense"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PilotLicense"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The crew member vested with command authority and overall responsibility for the safe conduct of the flight.</rdfs:comment>
        <rdfs:label xml:lang="en">Commander</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CommercialAirTransportOperation -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CommercialAirTransportOperation">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightOperation"/>
        <owl:disjointWith rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#NonCommercialOperation"/>
        <owl:disjointWith rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SpecialisedOperation"/>
        <rdfs:comment xml:lang="en">An aircraft operation involving the transport of passengers, cargo, or mail for remuneration or hire.</rdfs:comment>
        <rdfs:label xml:lang="en">Commercial Air Transport Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ComponentOverhaul -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ComponentOverhaul">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#MaintenanceActivity"/>
        <rdfs:comment xml:lang="en">The disassembly, inspection, repair, and restoration of an aircraft component to a serviceable condition.</rdfs:comment>
        <rdfs:label xml:lang="en">Component Overhaul</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Consignee -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Consignee">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Agent"/>
        <rdfs:comment xml:lang="en">The person or company to whom the goods are to be delivered.</rdfs:comment>
        <rdfs:label xml:lang="en">Consignee</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Consignment -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Consignment">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PhysicalObject"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasConsignee"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignee"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasShipper"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Shipper"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#includesCargoItem"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Cargo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#usesAirwayBill"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AirwayBill"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A shipment of one or more cargo items tendered by one shipper and transported under one air waybill. A consignment is an aggregate of cargo items, not itself a cargo item.</rdfs:comment>
        <rdfs:label xml:lang="en">Consignment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ContainerBuildUp -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ContainerBuildUp">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingOperation"/>
        <rdfs:comment xml:lang="en">The consolidation of shipments into a ULD.</rdfs:comment>
        <rdfs:label xml:lang="en">Container Build-Up</rdfs:label>
        <skos:altLabel xml:lang="en">ULD Build-Up</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ControlTower -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ControlTower">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An airport facility from which air traffic controllers direct aircraft movement on the ground and in the air near the airport.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Tower</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ControlledAirspace -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ControlledAirspace">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Airspace"/>
        <rdfs:comment xml:lang="en">Airspace within which air traffic control service is provided to aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Controlled Airspace</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ConveyorBelt -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ConveyorBelt">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingEquipment"/>
        <rdfs:comment xml:lang="en">A conveyor used to transport shipments through a handling facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Conveyor Belt</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CrewMember -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CrewMember">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Person"/>
        <rdfs:comment xml:lang="en">A person assigned to operational or service duties aboard an aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Crew Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Cruise -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Cruise">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightPhase"/>
        <rdfs:comment xml:lang="en">The phase of flight at a stable altitude and speed between climb and descent.</rdfs:comment>
        <rdfs:label xml:lang="en">Cruise</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CustomsAuthority -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CustomsAuthority">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#RegulatoryAuthority"/>
        <rdfs:comment xml:lang="en">A government agency responsible for controlling the flow of goods, including cargo, into and out of a country.</rdfs:comment>
        <rdfs:label xml:lang="en">Customs Authority</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CustomsClearance -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CustomsClearance">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:comment xml:lang="en">A formal process of obtaining government permission to export or import goods.</rdfs:comment>
        <rdfs:label xml:lang="en">Customs Clearance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CustomsClearanceAgency -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CustomsClearanceAgency">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">An authorised service provider responsible for processing customs declarations.</rdfs:comment>
        <rdfs:label xml:lang="en">Customs Clearance Agency</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CustomsDeclaration -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CustomsDeclaration">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A form listing the details of goods being transported across borders.</rdfs:comment>
        <rdfs:label xml:lang="en">Customs Declaration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CustomsException -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CustomsException">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ShipmentException"/>
        <rdfs:comment xml:lang="en">A customs-related exception encountered during shipment handling.</rdfs:comment>
        <rdfs:label xml:lang="en">Customs Exception</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CustomsPermit -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CustomsPermit">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">Official authorisation granted by customs to allow export or import of cargo.</rdfs:comment>
        <rdfs:label xml:lang="en">Customs Permit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CustomsWarehouse -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CustomsWarehouse">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Warehouse"/>
        <rdfs:comment xml:lang="en">An authorised location for storing cargo awaiting customs clearance.</rdfs:comment>
        <rdfs:label xml:lang="en">Customs Warehouse</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#CutTime -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CutTime">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Measurement"/>
        <rdfs:comment xml:lang="en">The latest time by which cargo must be delivered to the airline for loading onto a scheduled flight.</rdfs:comment>
        <rdfs:label xml:lang="en">Cut Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#DangerousGoods -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#DangerousGoods">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Cargo"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#classifiedAs"/>
                        <owl:hasValue rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#DangerousGoodsCargoType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Cargo"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#requiresHazardLabel"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Label"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Items classified as hazardous for air transport, requiring special handling and labelling.</rdfs:comment>
        <rdfs:label xml:lang="en">Dangerous Goods</rdfs:label>
        <skos:altLabel xml:lang="en">DG</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#DeBagging -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#DeBagging">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingOperation"/>
        <rdfs:comment xml:lang="en">The removal of parcels from transport bags.</rdfs:comment>
        <rdfs:label xml:lang="en">De-Bagging</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Deicing -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Deicing">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#GroundHandlingService"/>
        <rdfs:comment xml:lang="en">The removal or prevention of ice and frost accumulation on an aircraft prior to departure.</rdfs:comment>
        <rdfs:label xml:lang="en">Deicing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#DemonstrationFlight -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#DemonstrationFlight">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:comment xml:lang="en">A flight conducted to demonstrate an aircraft&apos;s capabilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Demonstration Flight</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#DepartureGate -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#DepartureGate">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Terminal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An airport terminal section where passengers wait before boarding.</rdfs:comment>
        <rdfs:label xml:lang="en">Departure Gate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Destination -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Destination">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Location"/>
        <rdfs:comment xml:lang="en">The final location where a flight or cargo shipment is to be delivered.</rdfs:comment>
        <rdfs:label xml:lang="en">Destination</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:editorialNote xml:lang="en">Deprecated in 0.2.0: origin/destination are roles a place plays for a shipment. Use hasOrigin/hasDestination pointing directly at an Aerodrome, Location or premises.</skos:editorialNote>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#DirectFlight -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#DirectFlight">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasIntermediateStop"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:comment xml:lang="en">A flight that travels from origin to destination without stopovers.</rdfs:comment>
        <rdfs:label xml:lang="en">Direct Flight</rdfs:label>
        <skos:altLabel xml:lang="en">Non-stop Flight</skos:altLabel>
        <skos:editorialNote xml:lang="en">In airline usage a &apos;direct&apos; flight may stop en route under one flight number; this class follows the non-stop meaning.</skos:editorialNote>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#DispatchSchedule -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#DispatchSchedule">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#InformationObject"/>
        <rdfs:comment xml:lang="en">The planned timing for shipping goods from the origin.</rdfs:comment>
        <rdfs:label xml:lang="en">Dispatch Schedule</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Document -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Document">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#InformationObject"/>
        <owl:disjointWith rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Identifier"/>
        <rdfs:comment xml:lang="en">A record, form, or certificate that carries information for legal, operational, or logistical purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">Document</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#EDISystem -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#EDISystem">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#InformationObject"/>
        <rdfs:comment xml:lang="en">An Electronic Data Interchange system used to submit shipping documents digitally.</rdfs:comment>
        <rdfs:label xml:lang="en">EDI System</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#EmergencyEquipment -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#EmergencyEquipment">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Equipment"/>
        <rdfs:comment xml:lang="en">Equipment carried or provided for use in an aviation emergency, such as fire suppression or evacuation equipment.</rdfs:comment>
        <rdfs:label xml:lang="en">Emergency Equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#EnergyConsumption -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#EnergyConsumption">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Measurement"/>
        <rdfs:comment xml:lang="en">The amount of energy used by an aircraft or ground equipment during operation.</rdfs:comment>
        <rdfs:label xml:lang="en">Energy Consumption</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#EnergySource -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#EnergySource">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Category"/>
        <rdfs:comment xml:lang="en">A classification of the type of energy used to power an aircraft or ground equipment (e.g. jet fuel, electricity, sustainable aviation fuel).</rdfs:comment>
        <rdfs:label xml:lang="en">Energy Source</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#EnergyUnit -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#EnergyUnit">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Measurement"/>
        <rdfs:comment xml:lang="en">A quantity of energy consumed, expressed in a defined unit (e.g. litres of fuel, kWh).</rdfs:comment>
        <rdfs:label xml:lang="en">Energy Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#EnvironmentalRegulation -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#EnvironmentalRegulation">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PolicyOrRegulation"/>
        <rdfs:comment xml:lang="en">A regulation governing the environmental impact of aviation operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Regulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Equipment -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Equipment">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PhysicalObject"/>
        <rdfs:comment xml:lang="en">A physical item of apparatus or machinery used to support air transport operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ExceptionRecord -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ExceptionRecord">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A record of a shipment exception raised during handling.</rdfs:comment>
        <rdfs:label xml:lang="en">Exception Record</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ExplosiveInspection -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ExplosiveInspection">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SecurityScreening"/>
        <rdfs:comment xml:lang="en">A security screening process to ensure cargo does not contain explosives.</rdfs:comment>
        <rdfs:label xml:lang="en">Explosive Inspection</rdfs:label>
        <skos:altLabel xml:lang="en">Explosive Trace Detection</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ExportCustomsClearance -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ExportCustomsClearance">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CustomsClearance"/>
        <owl:disjointWith rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ImportCustomsClearance"/>
        <rdfs:comment xml:lang="en">Customs clearance conducted for goods leaving the country of origin.</rdfs:comment>
        <rdfs:label xml:lang="en">Export Customs Clearance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Exporter -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Exporter">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Agent"/>
        <rdfs:comment xml:lang="en">The party (person or organisation) that dispatches goods from the country of origin to a foreign country.</rdfs:comment>
        <rdfs:label xml:lang="en">Exporter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ExtendableConveyor -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ExtendableConveyor">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#GroundSupportEquipment"/>
        <rdfs:comment xml:lang="en">An extending conveyor used to load or unload cargo directly into or from a truck.</rdfs:comment>
        <rdfs:label xml:lang="en">Extendable Conveyor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FareClass -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FareClass">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Category"/>
        <rdfs:comment xml:lang="en">A booking code representing a specific fare and set of conditions within a passenger class.</rdfs:comment>
        <rdfs:label xml:lang="en">Fare Class</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FerryFlight -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FerryFlight">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:comment xml:lang="en">A non-revenue flight conducted to reposition an aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Ferry Flight</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FirstOfficer -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FirstOfficer">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightCrew"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#holdsLicense"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PilotLicense"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A qualified pilot who assists the Pilot in Command in operating the aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">First Officer</rdfs:label>
        <skos:altLabel xml:lang="en">Co-pilot</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Flight -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Flight">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#usesAircraft"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aircraft"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#arrivedAt"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#departedFrom"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A single journey (leg) of an aircraft from a departure aerodrome to an arrival aerodrome, whether scheduled or not.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightCost -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightCost">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Measurement"/>
        <rdfs:comment xml:lang="en">The financial cost associated with operating a flight.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Cost</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightCrew -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightCrew">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CrewMember"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasMedicalCertificate"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#MedicalCertificate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#holdsLicense"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Licence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Personnel responsible for operating the aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Crew</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightDataMonitoring -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightDataMonitoring">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:comment xml:lang="en">The routine analysis of recorded flight data to identify safety trends and improve operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Data Monitoring</rdfs:label>
        <skos:altLabel xml:lang="en">FDM</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightDiversion -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightDiversion">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#OperationalDisruption"/>
        <rdfs:comment xml:lang="en">A flight diverted from its planned destination.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Diversion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightInformationRegion -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightInformationRegion">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Airspace"/>
        <rdfs:comment xml:lang="en">A defined volume of airspace within which flight information and alerting services are provided.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Information Region</rdfs:label>
        <skos:altLabel xml:lang="en">FIR</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightManifest -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightManifest">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A list of passengers or cargo aboard a particular flight.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Manifest</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightOperation -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightOperation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#CommercialAirTransportOperation"/>
                    <rdf:Description rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#NonCommercialOperation"/>
                    <rdf:Description rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SpecialisedOperation"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:comment xml:lang="en">The conduct of a flight or series of flights under a defined operational category.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightOperationsOfficer -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightOperationsOfficer">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#GroundPersonnel"/>
        <rdfs:comment xml:lang="en">Personnel who assist in flight planning, dispatch, and monitoring of flights.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Operations Officer</rdfs:label>
        <skos:altLabel xml:lang="en">Dispatcher</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightPhase -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightPhase">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A distinct stage within the conduct of a flight.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Phase</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightPlan -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightPlan">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A document filed with air traffic services detailing a flight&apos;s intended route, altitude, timing, and fuel.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Plan</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightRecorder -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightRecorder">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AircraftComponent"/>
        <rdfs:comment xml:lang="en">An onboard device that records flight data and/or cockpit audio for safety investigation purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Recorder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FlightSchedule -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FlightSchedule">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A timetable showing the planned flights of an airline.</rdfs:comment>
        <rdfs:label xml:lang="en">Flight Schedule</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FreightForwarder -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FreightForwarder">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">A logistics service provider that arranges cargo transport, documentation, and compliance on behalf of exporters/importers.</rdfs:comment>
        <rdfs:label xml:lang="en">Freight Forwarder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#FreighterAircraft -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#FreighterAircraft">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aircraft"/>
        <owl:disjointWith rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PassengerAircraft"/>
        <rdfs:comment xml:lang="en">An aircraft designed specifically to carry freight or cargo, with no passenger cabin.</rdfs:comment>
        <rdfs:label xml:lang="en">Freighter Aircraft</rdfs:label>
        <skos:altLabel xml:lang="en">Cargo Aircraft</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#GroundHandlingAgent -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#GroundHandlingAgent">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">A company contracted to provide ground handling services (baggage, ramp, catering, etc.) to airlines at an airport.</rdfs:comment>
        <rdfs:label xml:lang="en">Ground Handling Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#GroundHandlingService -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#GroundHandlingService">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:comment xml:lang="en">A service performed to support an aircraft&apos;s turnaround at an airport.</rdfs:comment>
        <rdfs:label xml:lang="en">Ground Handling Service</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#GroundPersonnel -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#GroundPersonnel">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Person"/>
        <rdfs:comment xml:lang="en">Staff who perform operational duties on the ground rather than aboard an aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Ground Personnel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#GroundSupportEquipment -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#GroundSupportEquipment">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Equipment"/>
        <rdfs:comment xml:lang="en">Vehicles and equipment used to service aircraft while on the ground.</rdfs:comment>
        <rdfs:label xml:lang="en">Ground Support Equipment</rdfs:label>
        <skos:altLabel xml:lang="en">GSE</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#GroundTransport -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#GroundTransport">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#TransportMode"/>
        <rdfs:comment xml:lang="en">Vehicle-based transport used to move goods or passengers to/from the airport.</rdfs:comment>
        <rdfs:label xml:lang="en">Ground Transport</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#GroundVehicle -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#GroundVehicle">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PhysicalObject"/>
        <rdfs:comment xml:lang="en">A road vehicle (e.g. a truck or van) used to move cargo or passengers to or from an airport.</rdfs:comment>
        <rdfs:label xml:lang="en">Ground Vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#HandSearch -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#HandSearch">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SecurityScreening"/>
        <rdfs:comment xml:lang="en">Manual security inspection of baggage or cargo.</rdfs:comment>
        <rdfs:label xml:lang="en">Hand Search</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Hangar -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Hangar">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:comment xml:lang="en">A building used to store, maintain, or repair aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Hangar</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#HeldShipment -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#HeldShipment">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ShipmentException"/>
        <rdfs:comment xml:lang="en">A shipment held pending resolution of an exception.</rdfs:comment>
        <rdfs:label xml:lang="en">Held Shipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Helicopter -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Helicopter">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aircraft"/>
        <rdfs:comment xml:lang="en">A rotorcraft that derives lift and propulsion from horizontally spinning rotors, used for passenger, cargo, or specialised operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Helicopter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#HouseAirwayBill -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#HouseAirwayBill">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AirwayBill"/>
        <owl:disjointWith rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#MasterAirwayBill"/>
        <rdfs:comment xml:lang="en">A shipment document issued by a freight forwarder for individual consignments.</rdfs:comment>
        <rdfs:label xml:lang="en">House Airway Bill</rdfs:label>
        <skos:altLabel xml:lang="en">HAWB</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#IATACode -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#IATACode">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Identifier"/>
        <rdfs:comment xml:lang="en">A unique 3-letter identifier for airlines and airports issued by IATA.</rdfs:comment>
        <rdfs:label xml:lang="en">IATA Code</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ICAOCode -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ICAOCode">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Identifier"/>
        <rdfs:comment xml:lang="en">A 4-letter or alphanumeric code designating airports, airlines, or aircraft, issued by ICAO.</rdfs:comment>
        <rdfs:label xml:lang="en">ICAO Code</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Identifier -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Identifier">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#InformationObject"/>
        <rdfs:comment xml:lang="en">A code or designator that uniquely identifies an entity within an identification scheme (e.g. IATA or ICAO codes).</rdfs:comment>
        <rdfs:label xml:lang="en">Identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ImportCustomsClearance -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ImportCustomsClearance">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CustomsClearance"/>
        <rdfs:comment xml:lang="en">Customs clearance conducted for goods entering the destination country.</rdfs:comment>
        <rdfs:label xml:lang="en">Import Customs Clearance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Importer -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Importer">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Agent"/>
        <rdfs:comment xml:lang="en">The party (person or organisation) that receives goods in the destination country after import clearance.</rdfs:comment>
        <rdfs:label xml:lang="en">Importer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#InformationObject -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#InformationObject">
        <rdfs:comment xml:lang="en">A document, record, code, message, or digital artefact that carries information within air transport operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Information Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PhysicalObject"/>
        <rdfs:comment xml:lang="en">A fixed facility or structure that supports air transport operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Infrastructure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#InsuranceProvider -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#InsuranceProvider">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">An organization that provides insurance cover for aircraft, cargo, or aviation liability.</rdfs:comment>
        <rdfs:label xml:lang="en">Insurance Provider</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Invoice -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Invoice">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A commercial document stating the value of the goods and transaction details.</rdfs:comment>
        <rdfs:label xml:lang="en">Invoice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#KPI -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#KPI">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Measurement"/>
        <rdfs:comment xml:lang="en">A Key Performance Indicator used to measure airport or airline operational performance.</rdfs:comment>
        <rdfs:label xml:lang="en">KPI</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Label -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Label">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A tag placed on cargo to identify flight, destination, and handling instructions.</rdfs:comment>
        <rdfs:label xml:lang="en">Label</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Landing -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Landing">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightPhase"/>
        <rdfs:comment xml:lang="en">The phase in which an aircraft transitions from flight to ground movement.</rdfs:comment>
        <rdfs:label xml:lang="en">Landing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#LeaseAgreement -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#LeaseAgreement">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A contract under which an aircraft owner grants an airline the right to operate the aircraft for a defined period.</rdfs:comment>
        <rdfs:label xml:lang="en">Lease Agreement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#LeasedAircraft -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#LeasedAircraft">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Aircraft"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#leasedUnder"/>
                        <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#LeaseAgreement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Defined class: any aircraft operated under a lease agreement. Membership is inferred by the reasoner.</rdfs:comment>
        <rdfs:label xml:lang="en">Leased Aircraft</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#LeasingCompany -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#LeasingCompany">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">An organization that owns aircraft and leases them to airlines under a lease agreement.</rdfs:comment>
        <rdfs:label xml:lang="en">Leasing Company</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Licence -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Licence">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Certificate"/>
        <rdfs:comment xml:lang="en">A certificate issued to a person authorising them to exercise specified privileges (e.g. pilot, ATCO or engineer licence).</rdfs:comment>
        <rdfs:label xml:lang="en">Licence</rdfs:label>
        <skos:altLabel xml:lang="en">License</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#LiftingEquipment -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#LiftingEquipment">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#GroundSupportEquipment"/>
        <rdfs:comment xml:lang="en">Equipment that assists with loading and unloading cargo or baggage.</rdfs:comment>
        <rdfs:label xml:lang="en">Lifting Equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#LineMaintenance -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#LineMaintenance">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#MaintenanceActivity"/>
        <rdfs:comment xml:lang="en">Routine maintenance performed on an aircraft between flights, typically at an airport.</rdfs:comment>
        <rdfs:label xml:lang="en">Line Maintenance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Location -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Location">
        <rdfs:comment xml:lang="en">A geographic, spatial, or airspace entity relevant to air transport.</rdfs:comment>
        <rdfs:label xml:lang="en">Location</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#LooseLoading -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#LooseLoading">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingOperation"/>
        <rdfs:comment xml:lang="en">The direct loading of cargo into trucks without using ULDs.</rdfs:comment>
        <rdfs:label xml:lang="en">Loose Loading</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#METAR -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#METAR">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A routine, coded surface weather observation report used in aviation.</rdfs:comment>
        <rdfs:label xml:lang="en">METAR</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#MROOrganization -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#MROOrganization">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">An organization approved to perform aircraft Maintenance, Repair, and Overhaul (MRO).</rdfs:comment>
        <rdfs:label xml:lang="en">MRO Organization</rdfs:label>
        <skos:altLabel xml:lang="en">MRO</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#MaintenanceActivity -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#MaintenanceActivity">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:comment xml:lang="en">An activity performed to inspect, service, or repair an aircraft or its components.</rdfs:comment>
        <rdfs:label xml:lang="en">Maintenance Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#MaintenanceCheckFlight -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#MaintenanceCheckFlight">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:comment xml:lang="en">A flight conducted to verify aircraft airworthiness following maintenance.</rdfs:comment>
        <rdfs:label xml:lang="en">Maintenance Check Flight</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#MaintenanceEngineer -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#MaintenanceEngineer">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#holdsLicense"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Licence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A licensed person qualified to inspect, maintain, and certify aircraft airworthiness.</rdfs:comment>
        <rdfs:label xml:lang="en">Maintenance Engineer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ManageService -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ManageService">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Service"/>
        <rdfs:comment xml:lang="en">A service that supports the active management of airport or flight operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Manage Service</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ManualScanning -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ManualScanning">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SecurityScreening"/>
        <rdfs:comment xml:lang="en">Manual scanning of a shipment identifier by an operator.</rdfs:comment>
        <rdfs:label xml:lang="en">Manual Scanning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ManualXRayMachine -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ManualXRayMachine">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ScreeningEquipment"/>
        <rdfs:comment xml:lang="en">A manually operated X-ray machine used for security screening.</rdfs:comment>
        <rdfs:label xml:lang="en">Manual X-Ray Machine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Marshalling -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Marshalling">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#GroundHandlingService"/>
        <rdfs:comment xml:lang="en">The visual guidance of an aircraft during taxiing, parking, or pushback by ground staff.</rdfs:comment>
        <rdfs:label xml:lang="en">Marshalling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#MasterAirwayBill -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#MasterAirwayBill">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AirwayBill"/>
        <rdfs:comment xml:lang="en">A shipment document issued by the airline to the freight forwarder for consolidated cargo.</rdfs:comment>
        <rdfs:label xml:lang="en">Master Airway Bill</rdfs:label>
        <skos:altLabel xml:lang="en">MAWB</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#MasterMinimumEquipmentList -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#MasterMinimumEquipmentList">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">The baseline list, approved for an aircraft type, from which an operator&apos;s Minimum Equipment List is derived.</rdfs:comment>
        <rdfs:label xml:lang="en">Master Minimum Equipment List</rdfs:label>
        <skos:altLabel xml:lang="en">MMEL</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Measurement -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Measurement">
        <rdfs:comment xml:lang="en">A quantity, metric, classification, or measured/assigned value used in air transport operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#MedicalCertificate -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#MedicalCertificate">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Certificate"/>
        <rdfs:comment xml:lang="en">A certificate confirming that a crew member meets the medical fitness requirements for their role.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical Certificate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#MinimumEquipmentList -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#MinimumEquipmentList">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A list, specific to an aircraft, of equipment that may be inoperative for dispatch under defined conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">Minimum Equipment List</rdfs:label>
        <skos:altLabel xml:lang="en">MEL</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#MonitorService -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#MonitorService">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Service"/>
        <rdfs:comment xml:lang="en">A service that monitors current airport or flight operations in real time.</rdfs:comment>
        <rdfs:label xml:lang="en">Monitor Service</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#MultimodalLink -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#MultimodalLink">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Location"/>
        <rdfs:comment xml:lang="en">A connection point between air and road (or other) transport systems.</rdfs:comment>
        <rdfs:label xml:lang="en">Multimodal Link</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#NOTAM -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#NOTAM">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A Notice to Airmen, distributed to alert pilots of potential hazards or changes to facilities, services, or procedures.</rdfs:comment>
        <rdfs:label xml:lang="en">NOTAM</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#NoiseRegulation -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#NoiseRegulation">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#EnvironmentalRegulation"/>
        <rdfs:comment xml:lang="en">A regulation restricting or managing aircraft noise, particularly around airports.</rdfs:comment>
        <rdfs:label xml:lang="en">Noise Regulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#NonCommercialOperation -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#NonCommercialOperation">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightOperation"/>
        <rdfs:comment xml:lang="en">An aircraft operation other than commercial air transport, not undertaken for remuneration or hire.</rdfs:comment>
        <rdfs:label xml:lang="en">Non-Commercial Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Occurrence -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Occurrence">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:comment xml:lang="en">An unplanned event that affects, or could affect, normal operations. Safety incidents are one kind of occurrence; operational disruptions and shipment exceptions are others.</rdfs:comment>
        <rdfs:label xml:lang="en">Occurrence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Offloading -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Offloading">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingOperation"/>
        <rdfs:comment xml:lang="en">The removal of cargo or ULDs from an aircraft.</rdfs:comment>
        <rdfs:label xml:lang="en">Offloading</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#OperationalControlSystem -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#OperationalControlSystem">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#InformationObject"/>
        <rdfs:comment xml:lang="en">A system used by an operator to exercise control over the initiation, continuation, diversion, or termination of a flight.</rdfs:comment>
        <rdfs:label xml:lang="en">Operational Control System</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#OperationalData -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#OperationalData">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#InformationObject"/>
        <rdfs:comment xml:lang="en">Data describing the current or historical state of airport or flight operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Operational Data</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#OperationalDisruption -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#OperationalDisruption">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Occurrence"/>
        <rdfs:comment xml:lang="en">An unexpected disruption to planned operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Operational Disruption</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#OperationsManual -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#OperationsManual">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A manual, approved by the regulator, describing an operator&apos;s procedures for the safe conduct of operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Operations Manual</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Organization -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Organization">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Agent"/>
        <owl:disjointWith rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Person"/>
        <rdfs:comment xml:lang="en">A formally structured group that acts as a single entity within air transport.</rdfs:comment>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Origin -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Origin">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Location"/>
        <rdfs:comment xml:lang="en">The starting point of a flight or cargo journey.</rdfs:comment>
        <rdfs:label xml:lang="en">Origin</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:editorialNote xml:lang="en">Deprecated in 0.2.0: origin/destination are roles a place plays for a shipment. Use hasOrigin/hasDestination pointing directly at an Aerodrome, Location or premises.</skos:editorialNote>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#PackingCompany -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#PackingCompany">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">A service provider responsible for securely packing cargo before shipment.</rdfs:comment>
        <rdfs:label xml:lang="en">Packing Company</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#PackingList -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#PackingList">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A detailed list of the contents of the shipment.</rdfs:comment>
        <rdfs:label xml:lang="en">Packing List</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Parcel -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Parcel">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Cargo"/>
        <rdfs:comment xml:lang="en">An individual shipment.</rdfs:comment>
        <rdfs:label xml:lang="en">Parcel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Passenger -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Passenger">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Person"/>
        <rdfs:comment xml:lang="en">An individual who travels in an aircraft but is not part of the crew.</rdfs:comment>
        <rdfs:label xml:lang="en">Passenger</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#PassengerAircraft -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#PassengerAircraft">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aircraft"/>
        <rdfs:comment xml:lang="en">An aircraft primarily designed to transport passengers.</rdfs:comment>
        <rdfs:label xml:lang="en">Passenger Aircraft</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#PassengerClass -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#PassengerClass">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Category"/>
        <rdfs:comment xml:lang="en">The category of service assigned to a passenger (e.g. economy, business).</rdfs:comment>
        <rdfs:label xml:lang="en">Passenger Class</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#PerformanceService -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#PerformanceService">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Service"/>
        <rdfs:comment xml:lang="en">A service that measures and reports on airport or airline operational performance.</rdfs:comment>
        <rdfs:label xml:lang="en">Performance Service</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Person -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Person">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Agent"/>
        <rdfs:comment xml:lang="en">An individual human being.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#PhysicalObject -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#PhysicalObject">
        <rdfs:comment xml:lang="en">A material entity that occupies space, such as an aircraft, item of equipment, cargo, or piece of infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#PilotInCommand -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#PilotInCommand">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightCrew"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#holdsLicense"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PilotLicense"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The pilot designated as being in command and responsible for the safe conduct of the flight.</rdfs:comment>
        <rdfs:label xml:lang="en">Pilot in Command</rdfs:label>
        <skos:altLabel xml:lang="en">Captain</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#PilotLicense -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#PilotLicense">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Licence"/>
        <rdfs:comment xml:lang="en">A licence issued by a competent authority certifying that a pilot is qualified to act in a specified capacity.</rdfs:comment>
        <rdfs:label xml:lang="en">Pilot License</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#PolicyOrRegulation -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#PolicyOrRegulation">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#InformationObject"/>
        <rdfs:comment xml:lang="en">A rule, standard, directive, or regulatory instrument governing air transport.</rdfs:comment>
        <rdfs:label xml:lang="en">Policy or Regulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#PostOpsAnalysisService -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#PostOpsAnalysisService">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Service"/>
        <rdfs:comment xml:lang="en">A service that analyses completed operations to identify performance trends and improvement opportunities.</rdfs:comment>
        <rdfs:label xml:lang="en">Post-Operations Analysis Service</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Process -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Process">
        <rdfs:comment xml:lang="en">An activity, operation, or event that occurs over time within air transport operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Process</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Pushback -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Pushback">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#GroundHandlingService"/>
        <rdfs:comment xml:lang="en">The use of a tug to move an aircraft away from its gate before taxiing.</rdfs:comment>
        <rdfs:label xml:lang="en">Pushback</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Refuelling -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Refuelling">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#GroundHandlingService"/>
        <rdfs:comment xml:lang="en">The supply of fuel to an aircraft on the ground.</rdfs:comment>
        <rdfs:label xml:lang="en">Refuelling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#RegulatoryAuthority -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#RegulatoryAuthority">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Organization"/>
        <rdfs:comment xml:lang="en">A governmental or international body responsible for setting and enforcing aviation rules and standards.</rdfs:comment>
        <rdfs:label xml:lang="en">Regulatory Authority</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Reloading -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Reloading">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingOperation"/>
        <rdfs:comment xml:lang="en">The loading of sorted cargo for onward transport.</rdfs:comment>
        <rdfs:label xml:lang="en">Reloading</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#RoadNetwork -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#RoadNetwork">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Location"/>
        <rdfs:comment xml:lang="en">The interconnected system of road routes and road vehicles.</rdfs:comment>
        <rdfs:label xml:lang="en">Road Network</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Route -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Route">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Location"/>
        <rdfs:comment xml:lang="en">A designated air corridor between two airports.</rdfs:comment>
        <rdfs:label xml:lang="en">Route</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#RoutingException -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#RoutingException">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ShipmentException"/>
        <rdfs:comment xml:lang="en">A routing-related exception encountered during shipment handling.</rdfs:comment>
        <rdfs:label xml:lang="en">Routing Exception</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#RoutingInstruction -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#RoutingInstruction">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">Routing information used to direct a shipment through a sortation system.</rdfs:comment>
        <rdfs:label xml:lang="en">Routing Instruction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Runway -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Runway">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A strip of land at an airport on which aircraft can take off and land.</rdfs:comment>
        <rdfs:label xml:lang="en">Runway</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SafetyIncident -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SafetyIncident">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Occurrence"/>
        <rdfs:comment xml:lang="en">An occurrence involving an aircraft or aviation operation that affects or could affect safety.</rdfs:comment>
        <rdfs:label xml:lang="en">Safety Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SafetyManagementSystem -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SafetyManagementSystem">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PolicyOrRegulation"/>
        <rdfs:comment xml:lang="en">A systematic approach to managing safety, including the necessary organisational structures, accountabilities, policies, and procedures.</rdfs:comment>
        <rdfs:label xml:lang="en">Safety Management System</rdfs:label>
        <skos:altLabel xml:lang="en">SMS</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SafetyReport -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SafetyReport">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A report documenting a safety occurrence, hazard, or concern for review by safety management.</rdfs:comment>
        <rdfs:label xml:lang="en">Safety Report</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Scanner -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Scanner">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingEquipment"/>
        <rdfs:comment xml:lang="en">A device that reads shipment identifiers such as barcodes or airway bill numbers.</rdfs:comment>
        <rdfs:label xml:lang="en">Scanner</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Scenario -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Scenario">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#InformationObject"/>
        <rdfs:comment xml:lang="en">A defined operational situation, used for planning or simulation of airport or flight operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Scenario</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ScreeningEquipment -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ScreeningEquipment">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Equipment"/>
        <rdfs:comment xml:lang="en">Equipment used to inspect passengers, baggage, or cargo for prohibited or dangerous items.</rdfs:comment>
        <rdfs:label xml:lang="en">Screening Equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ScreeningResult -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ScreeningResult">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">The recorded result of a security screening process.</rdfs:comment>
        <rdfs:label xml:lang="en">Screening Result</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SecurityException -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SecurityException">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ShipmentException"/>
        <rdfs:comment xml:lang="en">A security-related exception encountered during shipment handling.</rdfs:comment>
        <rdfs:label xml:lang="en">Security Exception</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SecurityScreening -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SecurityScreening">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Process"/>
        <rdfs:comment xml:lang="en">A process to inspect passengers, baggage, or cargo before boarding or onward transport.</rdfs:comment>
        <rdfs:label xml:lang="en">Security Screening</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SeriousIncident -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SeriousIncident">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#SafetyIncident"/>
        <rdfs:comment xml:lang="en">An occurrence, other than an accident, associated with the operation of an aircraft in which safety was seriously compromised.</rdfs:comment>
        <rdfs:label xml:lang="en">Serious Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Service -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Service">
        <rdfs:comment xml:lang="en">A defined capability or function offered by a system, facility, or organization.</rdfs:comment>
        <rdfs:label xml:lang="en">Service</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ServiceBulletin -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ServiceBulletin">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A notice issued by a manufacturer recommending or describing modifications, inspections, or repairs to a product.</rdfs:comment>
        <rdfs:label xml:lang="en">Service Bulletin</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ShipmentException -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ShipmentException">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Occurrence"/>
        <rdfs:comment xml:lang="en">An unplanned event that interrupts the normal handling of a shipment.</rdfs:comment>
        <rdfs:label xml:lang="en">Shipment Exception</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Shipper -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Shipper">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Agent"/>
        <rdfs:comment xml:lang="en">The party that tenders goods for carriage and is named as such on the airway bill.</rdfs:comment>
        <rdfs:label xml:lang="en">Shipper</rdfs:label>
        <skos:altLabel xml:lang="en">Consignor</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#ShippingInstruction -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#ShippingInstruction">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A document outlining the exporter&apos;s request to arrange shipment.</rdfs:comment>
        <rdfs:label xml:lang="en">Shipping Instruction</rdfs:label>
        <skos:altLabel xml:lang="en">SI</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Slot -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Slot">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#InformationObject"/>
        <rdfs:comment xml:lang="en">An authorisation to use the full range of airport infrastructure necessary to arrive or depart at an airport on a specific date and time.</rdfs:comment>
        <rdfs:label xml:lang="en">Slot</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SmallParcel -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SmallParcel">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Parcel"/>
        <rdfs:comment xml:lang="en">A small shipment handled separately from standard cargo.</rdfs:comment>
        <rdfs:label xml:lang="en">Small Parcel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Sortation -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Sortation">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingOperation"/>
        <rdfs:comment xml:lang="en">The automated routing of shipments through a handling facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Sortation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SortationSystem -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SortationSystem">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingEquipment"/>
        <rdfs:comment xml:lang="en">Automated infrastructure that routes shipments to their correct destination within a facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Sortation System</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SpecialisedOperation -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SpecialisedOperation">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightOperation"/>
        <rdfs:comment xml:lang="en">An aircraft operation involving specialised activities such as aerial survey, agriculture, or construction.</rdfs:comment>
        <rdfs:label xml:lang="en">Specialised Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SpiralChute -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SpiralChute">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHandlingEquipment"/>
        <rdfs:comment xml:lang="en">A destination-specific chute used to route sorted shipments.</rdfs:comment>
        <rdfs:label xml:lang="en">Spiral Chute</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Stakeholder -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Stakeholder">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Agent"/>
        <rdfs:comment xml:lang="en">Any organization, role, or individual who contributes to, is affected by, or has an interest in airport or airline operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Stakeholder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SteerService -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SteerService">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Service"/>
        <rdfs:comment xml:lang="en">A service that supports collaborative decision-making to steer airport operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Steer Service</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#StorageShed -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#StorageShed">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Warehouse"/>
        <rdfs:comment xml:lang="en">A bonded holding area at the airport for cargo before loading or after unloading.</rdfs:comment>
        <rdfs:label xml:lang="en">Storage Shed</rdfs:label>
        <skos:altLabel xml:lang="en">Airside Storage Shed</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Supervisor -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Supervisor">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#GroundPersonnel"/>
        <rdfs:comment xml:lang="en">Personnel responsible for overseeing ground operations staff and activities.</rdfs:comment>
        <rdfs:label xml:lang="en">Supervisor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SustainableAviationFuel -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SustainableAviationFuel">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#EnergySource"/>
        <rdfs:comment xml:lang="en">An aviation fuel derived from non-petroleum feedstocks that reduces lifecycle carbon emissions relative to conventional jet fuel.</rdfs:comment>
        <rdfs:label xml:lang="en">Sustainable Aviation Fuel</rdfs:label>
        <skos:altLabel xml:lang="en">SAF</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#SystemFailure -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#SystemFailure">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Occurrence"/>
        <rdfs:comment xml:lang="en">The failure of an operational system or piece of equipment.</rdfs:comment>
        <rdfs:label xml:lang="en">System Failure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#TAF -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#TAF">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Document"/>
        <rdfs:comment xml:lang="en">A coded aerodrome weather forecast used in aviation.</rdfs:comment>
        <rdfs:label xml:lang="en">TAF</rdfs:label>
        <skos:altLabel xml:lang="en">Terminal Aerodrome Forecast</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Takeoff -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Takeoff">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightPhase"/>
        <rdfs:comment xml:lang="en">The phase in which an aircraft transitions from ground movement to flight.</rdfs:comment>
        <rdfs:label xml:lang="en">Takeoff</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Taxiing -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Taxiing">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightPhase"/>
        <rdfs:comment xml:lang="en">The movement of an aircraft on the ground under its own power.</rdfs:comment>
        <rdfs:label xml:lang="en">Taxiing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Taxiway -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Taxiway">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A defined path at an airport on which aircraft taxi between the runway and other airport facilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Taxiway</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#TechnicalCrew -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#TechnicalCrew">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CrewMember"/>
        <rdfs:comment xml:lang="en">Crew members responsible for technical/engineering duties during a flight.</rdfs:comment>
        <rdfs:label xml:lang="en">Technical Crew</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#Terminal -->


    <owl:Class rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#Terminal">
        <rdfs:subClassOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Infrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
                <owl:someValuesFrom rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
            </owl:Restriction>
