    <!-- http://www.cranfield.ac.uk/ontology/air-domain#flightOperatedBy -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#flightOperatedBy">
        <owl:inverseOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#operatesFlight"/>
        <rdfs:comment xml:lang="en">Relates a flight to the airline that operates it (inverse of operatesFlight).</rdfs:comment>
        <rdfs:label xml:lang="en">flight operated by</rdfs:label>
    </owl:ObjectProperty>
    


