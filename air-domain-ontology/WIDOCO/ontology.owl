    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasAirOperatorCertificate">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Airline"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AirOperatorCertificate"/>
        <rdfs:comment xml:lang="en">Relates an airline to its air operator certificate.</rdfs:comment>
        <rdfs:label xml:lang="en">has air operator certificate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasArrivalNotice -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasArrivalNotice">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ArrivalNotice"/>
        <rdfs:comment xml:lang="en">Links the cargo to the document confirming its arrival.</rdfs:comment>
        <rdfs:label xml:lang="en">has arrival notice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasBoardingPass -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasBoardingPass">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Passenger"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#BoardingPass"/>
        <rdfs:comment xml:lang="en">Relates a passenger to their boarding pass.</rdfs:comment>
        <rdfs:label xml:lang="en">has boarding pass</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasCertificateOfAirworthiness -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasCertificateOfAirworthiness">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aircraft"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CertificateOfAirworthiness"/>
        <rdfs:comment xml:lang="en">Relates an aircraft to its certificate of airworthiness.</rdfs:comment>
        <rdfs:label xml:lang="en">has certificate of airworthiness</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasChargingPoint -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasChargingPoint">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AirDepot"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ChargingPoint"/>
        <rdfs:comment xml:lang="en">Relates a depot to a charging point it hosts.</rdfs:comment>
        <rdfs:label xml:lang="en">has charging point</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasConsignee -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasConsignee">
        <rdfs:subPropertyOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasParty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignee"/>
        <rdfs:comment xml:lang="en">Relates a consignment to its consignee.</rdfs:comment>
        <rdfs:label xml:lang="en">has consignee</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasCrewMember -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasCrewMember">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CrewMember"/>
        <rdfs:comment xml:lang="en">Relates a flight to any member of its crew. Super-property of crewedBy (flight crew) and servedBy (cabin crew).</rdfs:comment>
        <rdfs:label xml:lang="en">has crew member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasDestination -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasDestination">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:comment xml:lang="en">Connects a shipment to its delivery location.</rdfs:comment>
        <rdfs:label xml:lang="en">has destination</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasDispatchSchedule -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasDispatchSchedule">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#DispatchSchedule"/>
        <rdfs:comment xml:lang="en">Associates a shipment with its planned dispatch date and time.</rdfs:comment>
        <rdfs:label xml:lang="en">has dispatch schedule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasExporter -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasExporter">
        <rdfs:subPropertyOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasParty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Exporter"/>
        <rdfs:comment xml:lang="en">Relates a shipment to the exporter responsible for dispatching it.</rdfs:comment>
        <rdfs:label xml:lang="en">has exporter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasFlightSchedule -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasFlightSchedule">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Airline"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightSchedule"/>
        <rdfs:comment xml:lang="en">Relates an airline to its flight schedule.</rdfs:comment>
        <rdfs:label xml:lang="en">has flight schedule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasImporter -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasImporter">
        <rdfs:subPropertyOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasParty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Importer"/>
        <rdfs:comment xml:lang="en">Relates a shipment to the importer receiving the goods.</rdfs:comment>
        <rdfs:label xml:lang="en">has importer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasIntermediateStop -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasIntermediateStop">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome"/>
        <rdfs:comment xml:lang="en">Relates a flight to an aerodrome at which it stops between departure and final arrival.</rdfs:comment>
        <rdfs:label xml:lang="en">has intermediate stop</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasInvoice -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasInvoice">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Invoice"/>
        <rdfs:comment xml:lang="en">Connects a shipment to its invoice for value declaration.</rdfs:comment>
        <rdfs:label xml:lang="en">has invoice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasLabel -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasLabel">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Cargo"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Label"/>
        <rdfs:comment xml:lang="en">Connects cargo to a label containing flight and safety information.</rdfs:comment>
        <rdfs:label xml:lang="en">has label</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasMedicalCertificate -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasMedicalCertificate">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CrewMember"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#MedicalCertificate"/>
        <rdfs:comment xml:lang="en">Relates a crew member to their medical certificate.</rdfs:comment>
        <rdfs:label xml:lang="en">has medical certificate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasOrigin -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasOrigin">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:comment xml:lang="en">Connects a shipment to its starting point.</rdfs:comment>
        <rdfs:label xml:lang="en">has origin</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasPackingCompany -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasPackingCompany">
        <rdfs:subPropertyOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasParty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PackingCompany"/>
        <rdfs:comment xml:lang="en">Associates the cargo with the company responsible for packing.</rdfs:comment>
        <rdfs:label xml:lang="en">has packing company</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasPackingList -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasPackingList">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PackingList"/>
        <rdfs:comment xml:lang="en">Links a shipment to the packing list outlining its contents.</rdfs:comment>
        <rdfs:label xml:lang="en">has packing list</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasPart -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasPart">
        <owl:inverseOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#partOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="en">Relates a whole to one of its parts. Transitive: a part of a part is a part of the whole.</rdfs:comment>
        <rdfs:label xml:lang="en">has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasParty -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasParty">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Agent"/>
        <rdfs:comment xml:lang="en">Relates a consignment to any agent involved in it. Super-property of shipper, consignee, exporter, importer, forwarder, packer and carrier relations, so &apos;who is involved in this shipment?&apos; is one query.</rdfs:comment>
        <rdfs:label xml:lang="en">has party</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasShipper -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasShipper">
        <rdfs:subPropertyOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasParty"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Shipper"/>
        <rdfs:comment xml:lang="en">Relates a consignment to its shipper.</rdfs:comment>
        <rdfs:label xml:lang="en">has shipper</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasShippingInstruction -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasShippingInstruction">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ShippingInstruction"/>
        <rdfs:comment xml:lang="en">Connects the export request to the shipping instructions.</rdfs:comment>
        <rdfs:label xml:lang="en">has shipping instruction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasTypeCertificate -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasTypeCertificate">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AircraftType"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#TypeCertificate"/>
        <rdfs:comment xml:lang="en">Relates an aircraft type to its type certificate.</rdfs:comment>
        <rdfs:label xml:lang="en">has type certificate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasTypeRating -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasTypeRating">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightCrew"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#TypeRating"/>
        <rdfs:comment xml:lang="en">Relates a pilot to a type rating they hold.</rdfs:comment>
        <rdfs:label xml:lang="en">has type rating</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#hasWarehouse -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#hasWarehouse">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Warehouse"/>
        <rdfs:comment xml:lang="en">Indicates the warehouse where the cargo is stored.</rdfs:comment>
        <rdfs:label xml:lang="en">has warehouse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#holdsLicense -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#holdsLicense">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Person"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Licence"/>
        <rdfs:comment xml:lang="en">Relates a person to a licence they hold.</rdfs:comment>
        <rdfs:label xml:lang="en">holds license</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#holdsRoleOf -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#holdsRoleOf">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Person"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Stakeholder"/>
        <rdfs:comment xml:lang="en">Relates a person to a stakeholder role they hold in an operation.</rdfs:comment>
        <rdfs:label xml:lang="en">holds role of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#includesCargoItem -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#includesCargoItem">
        <rdfs:subPropertyOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#hasPart"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Cargo"/>
        <rdfs:comment xml:lang="en">Associates a shipment with its individual cargo items.</rdfs:comment>
        <rdfs:label xml:lang="en">includes cargo item</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#includesULD -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#includesULD">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Consignment"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#ULD"/>
        <rdfs:comment xml:lang="en">Connects a shipment to the ULD in which it is consolidated.</rdfs:comment>
        <rdfs:label xml:lang="en">includes ULD</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#insuredBy -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#insuredBy">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aircraft"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#InsuranceProvider"/>
        <rdfs:comment xml:lang="en">Relates an aircraft to the organization providing its insurance cover.</rdfs:comment>
        <rdfs:label xml:lang="en">insured by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#interlinkedWithRoad -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#interlinkedWithRoad">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AirNetwork"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#RoadNetwork"/>
        <rdfs:comment xml:lang="en">Relates an air network to an interlinked road network.</rdfs:comment>
        <rdfs:label xml:lang="en">interlinked with road</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#issuesAirwayBill -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#issuesAirwayBill">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FreightForwarder"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AirwayBill"/>
        <rdfs:comment xml:lang="en">Relates a freight forwarder to an airway bill it issues.</rdfs:comment>
        <rdfs:label xml:lang="en">issues airway bill</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#issuesNOTAM -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#issuesNOTAM">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#AirNavigationServiceProvider"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#NOTAM"/>
        <rdfs:comment xml:lang="en">Relates an ANSP or authority to a NOTAM it issues.</rdfs:comment>
        <rdfs:label xml:lang="en">issues NOTAM</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#leasedUnder -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#leasedUnder">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Aircraft"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#LeaseAgreement"/>
        <rdfs:comment xml:lang="en">Relates an aircraft to the lease agreement under which it is operated.</rdfs:comment>
        <rdfs:label xml:lang="en">leased under</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#listedInManifest -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#listedInManifest">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Cargo"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#FlightManifest"/>
        <rdfs:comment xml:lang="en">Relates cargo to the flight manifest it is listed in.</rdfs:comment>
        <rdfs:label xml:lang="en">listed in manifest</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#loadedIn -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#loadedIn">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Baggage"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#CargoHold"/>
        <rdfs:comment xml:lang="en">Relates baggage to the cargo hold it is loaded in.</rdfs:comment>
        <rdfs:label xml:lang="en">loaded in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#loadedOnFlight -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#loadedOnFlight">
        <owl:inverseOf rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#carriesCargo"/>
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Cargo"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Flight"/>
        <rdfs:comment xml:lang="en">Indicates the specific flight carrying the cargo.</rdfs:comment>
        <rdfs:label xml:lang="en">loaded on flight</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#loadedOnTruckForDelivery -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#loadedOnTruckForDelivery">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Cargo"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#GroundVehicle"/>
        <rdfs:comment xml:lang="en">Shows that cargo is moved to truck transport after import clearance.</rdfs:comment>
        <rdfs:label xml:lang="en">loaded on truck for delivery</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#locatedAt -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#locatedAt">
        <rdfs:domain rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#PhysicalObject"/>
        <rdfs:range rdf:resource="http://www.cranfield.ac.uk/ontology/air-domain#Airport"/>
        <rdfs:comment xml:lang="en">Relates a facility or item of equipment to the airport where it is located.</rdfs:comment>
