        <rdfs:label xml:lang="en">regulated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cranfield.ac.uk/ontology/air-domain#regulatedByAuthority -->


    <owl:ObjectProperty rdf:about="http://www.cranfield.ac.uk/ontology/air-domain#regulatedByAuthority">
