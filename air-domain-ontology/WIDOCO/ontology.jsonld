  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "http://www.cranfield.ac.uk/ontology/air-domain#SeriousIncident"
  } ]
}, {
  "@id" : "http://www.cranfield.ac.uk/ontology/air-domain#Aerodrome",
