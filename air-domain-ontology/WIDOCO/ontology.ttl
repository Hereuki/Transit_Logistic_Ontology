@prefix : <http://www.cranfield.ac.uk/ontology/air-domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.cranfield.ac.uk/ontology/air-domain#> .

<http://www.cranfield.ac.uk/ontology/air-domain> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://www.cranfield.ac.uk/ontology/air-domain/0.2.0> ;
                                                  <http://purl.org/dc/elements/1.1/title> "Air Domain Ontology"@en ;
                                                  <http://purl.org/dc/terms/abstract> "An OWL 2 DL ontology of the civil air transport domain: passenger and cargo operations, airports, aircraft and airworthiness, flight operations and crew, air traffic management, ground handling, regulation, safety and security, and environmental sustainability."@en ;
                                                  <http://purl.org/dc/terms/title> "Air Domain Ontology"@en ;
                                                  <http://purl.org/vocab/vann/preferredNamespacePrefix> "air" ;
                                                  <http://purl.org/vocab/vann/preferredNamespaceUri> "http://www.cranfield.ac.uk/ontology/air-domain#" ;
                                                  rdfs:comment "A comprehensive ontology of the civil air transport domain, covering air passenger and cargo/freight operations, airport infrastructure and operations, aircraft and airworthiness, flight operations and crew, air traffic management, ground handling, regulatory/certification instruments, safety and security, and environmental sustainability. Consolidated from the project's existing class/relationship tables (Air_Freight_and_Passenger_Ontology, Sheet3 organisational/regulatory layers, the cargo-handling 'Category' breakdown, and the Airport Operations Plan / APOC concepts) and extended with generally-recognised air-domain concepts not yet captured there. No upper ontology (e.g. BFO) is imported; a small set of pragmatic top-level classes (Agent, PhysicalObject, InformationObject, Process, Location, PolicyOrRegulation, Measurement, Service, Category) organises the hierarchy instead."@en ;
                                                  rdfs:label "Air Domain Ontology"@en ;
                                                  owl:versionInfo "0.2.0" ;
                                                  <http://www.w3.org/2004/02/skos/core#changeNote> "0.2.0: fixed inverted/part-of subclass links (Aerodrome/Airport, AerodromeOperatingSite, ChargingPoint, Consignment); converted EASA, FAA, ICAO, IATA, CORSIA from classes to individuals; moved classifications out of Measurement into a new Category branch; added Identifier, Certificate, Licence, Occurrence, TradeAssociation, GroundVehicle; fixed IATAcode/ICAOcode range typos and over-narrow domains/ranges; added part-of, property hierarchy, inverses, functional properties, existential and cardinality restrictions, defined classes and disjointness axioms."@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#changeNote
<http://www.w3.org/2004/02/skos/core#changeNote> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#editorialNote
<http://www.w3.org/2004/02/skos/core#editorialNote> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.cranfield.ac.uk/ontology/air-domain#affectedByOperationalEvent
:affectedByOperationalEvent rdf:type owl:ObjectProperty ;
                            rdfs:domain :AirportOperationsCentre ;
                            rdfs:range :OperationalDisruption ;
                            rdfs:comment "Relates airport operations to an operational event affecting them."@en ;
                            rdfs:label "affected by operational event"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#affectedByWeather
:affectedByWeather rdf:type owl:ObjectProperty ;
                   rdfs:domain :Flight ;
                   rdfs:range :METAR ;
                   rdfs:comment "Relates a flight to a weather observation relevant to its conduct."@en ;
                   rdfs:label "affected by weather"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#allocatedSlot
:allocatedSlot rdf:type owl:ObjectProperty ;
               rdfs:domain :Flight ;
               rdfs:range :Slot ;
               rdfs:comment "Relates a flight to the airport slot allocated to it."@en ;
               rdfs:label "allocated slot"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#arrivedAt
:arrivedAt rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Flight ;
           rdfs:range :Aerodrome ;
           rdfs:comment "Relates a flight to the airport it arrived at."@en ;
           rdfs:label "arrived at"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#arrivesAtGate
:arrivesAtGate rdf:type owl:ObjectProperty ;
               rdfs:domain :Flight ;
               rdfs:range :ArrivalGate ;
               rdfs:comment "Relates a flight to the arrival gate it uses."@en ;
               rdfs:label "arrives at gate"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#arrivesViaTransitFlight
:arrivesViaTransitFlight rdf:type owl:ObjectProperty ;
                         rdfs:domain :Consignment ;
                         rdfs:range :TransitFlight ;
                         rdfs:comment "Shows that the shipment travels via a flight with layovers."@en ;
                         rdfs:label "arrives via transit flight"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#assignedRoute
:assignedRoute rdf:type owl:ObjectProperty ;
               rdfs:domain :Flight ;
               rdfs:range :Route ;
               rdfs:comment "Relates a flight to its assigned route."@en ;
               rdfs:label "assigned route"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#assignedToCargoHold
:assignedToCargoHold rdf:type owl:ObjectProperty ;
                     rdfs:domain :Cargo ;
                     rdfs:range :CargoHold ;
                     rdfs:comment "Relates cargo to the cargo hold it is assigned to."@en ;
                     rdfs:label "assigned to cargo hold"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#carriesCargo
:carriesCargo rdf:type owl:ObjectProperty ;
              rdfs:domain :Flight ;
              rdfs:range :Cargo ;
              rdfs:comment "Relates a flight to cargo it carries."@en ;
              rdfs:label "carries cargo"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#carriesPassenger
:carriesPassenger rdf:type owl:ObjectProperty ;
                  rdfs:domain :Flight ;
                  rdfs:range :Passenger ;
                  rdfs:comment "Relates a flight to a passenger it carries."@en ;
                  rdfs:label "carries passenger"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#certifiedBy
:certifiedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Airline ;
             rdfs:range :RegulatoryAuthority ;
             rdfs:comment "Relates an airline to the regulatory authority that certifies it."@en ;
             rdfs:label "certified by"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#checkedInAt
:checkedInAt rdf:type owl:ObjectProperty ;
             rdfs:domain :Passenger ;
             rdfs:range :CheckInCounter ;
             rdfs:comment "Relates a passenger to the check-in counter where they checked in."@en ;
             rdfs:label "checked in at"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#classifiedAs
:classifiedAs rdf:type owl:ObjectProperty ;
              rdfs:domain :Cargo ;
              rdfs:range :CargoType ;
              rdfs:comment "Relates cargo to its cargo type classification."@en ;
              rdfs:label "classified as"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#clearedThroughCustomsWarehouse
:clearedThroughCustomsWarehouse rdf:type owl:ObjectProperty ;
                                rdfs:domain :Cargo ;
                                rdfs:range :CustomsWarehouse ;
                                rdfs:comment "Links the cargo to the location where customs clearance is conducted."@en ;
                                rdfs:label "cleared through customs warehouse"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#constrainedByCapacity
:constrainedByCapacity rdf:type owl:ObjectProperty ;
                       rdfs:domain :AirportOperationsCentre ;
                       rdfs:range :Capacity ;
                       rdfs:comment "Relates airport operations to a capacity constraint that affects them."@en ;
                       rdfs:label "constrained by capacity"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#consumesEnergy
:consumesEnergy rdf:type owl:ObjectProperty ;
                rdfs:domain :Flight ;
                rdfs:range :EnergyUnit ;
                rdfs:comment "Relates a flight to the quantity of energy it consumes."@en ;
                rdfs:label "consumes energy"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#containsOperationalData
:containsOperationalData rdf:type owl:ObjectProperty ;
                         rdfs:domain :AirportOperationsCentre ;
                         rdfs:range :OperationalData ;
                         rdfs:comment "Relates an airport operations centre to the operational data it holds."@en ;
                         rdfs:label "contains operational data"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#contributesTo
:contributesTo rdf:type owl:ObjectProperty ;
               rdfs:domain :Stakeholder ;
               rdfs:range :AirportOperationsCentre ;
               rdfs:comment "Relates a stakeholder to the airport operations centre they contribute to."@en ;
               rdfs:label "contributes to"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#controlsFlight
:controlsFlight rdf:type owl:ObjectProperty ;
                rdfs:domain :AirTrafficControl ;
                rdfs:range :Flight ;
                rdfs:comment "Relates air traffic control to a flight it controls."@en ;
                rdfs:label "controls flight"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#crewedBy
:crewedBy rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :hasCrewMember ;
          rdfs:domain :Flight ;
          rdfs:range :FlightCrew ;
          rdfs:comment "Relates a flight to its flight crew."@en ;
          rdfs:label "crewed by"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#declaredByFreightForwarder
:declaredByFreightForwarder rdf:type owl:ObjectProperty ;
                            rdfs:domain :CustomsDeclaration ;
                            rdfs:range :FreightForwarder ;
                            rdfs:comment "Indicates the freight forwarder submitted the customs documentation."@en ;
                            rdfs:label "declared by freight forwarder"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#declaredThroughEDI
:declaredThroughEDI rdf:type owl:ObjectProperty ;
                    rdfs:domain :CustomsDeclaration ;
                    rdfs:range :EDISystem ;
                    rdfs:comment "Indicates the submission of shipment documents through an EDI system."@en ;
                    rdfs:label "declared through EDI"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#deliveredToImporter
:deliveredToImporter rdf:type owl:ObjectProperty ;
                     rdfs:domain :Cargo ;
                     rdfs:range :Importer ;
                     rdfs:comment "Indicates that cargo is transported to the importer's location."@en ;
                     rdfs:label "delivered to importer"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#departedFrom
:departedFrom rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Flight ;
              rdfs:range :Aerodrome ;
              rdfs:comment "Relates a flight to the airport it departed from."@en ;
              rdfs:label "departed from"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#departsFromGate
:departsFromGate rdf:type owl:ObjectProperty ;
                 rdfs:domain :Flight ;
                 rdfs:range :DepartureGate ;
                 rdfs:comment "Relates a flight to the departure gate it uses."@en ;
                 rdfs:label "departs from gate"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#documentedIn
:documentedIn rdf:type owl:ObjectProperty ;
              rdfs:domain :SafetyIncident ;
              rdfs:range :SafetyReport ;
              rdfs:comment "Relates a safety incident to the safety report documenting it."@en ;
              rdfs:label "documented in"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#emitsCarbon
:emitsCarbon rdf:type owl:ObjectProperty ;
             rdfs:domain :Flight ;
             rdfs:range :CarbonEmission ;
             rdfs:comment "Relates a flight to the carbon emissions it produces."@en ;
             rdfs:label "emits carbon"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#employedBy
:employedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Person ;
            rdfs:range :Organization ;
            rdfs:comment "Relates a person to the organization that employs them."@en ;
            rdfs:label "employed by"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#flightOperatedBy
:flightOperatedBy rdf:type owl:ObjectProperty ;
                  owl:inverseOf :operatesFlight ;
                  rdfs:comment "Relates a flight to the airline that operates it (inverse of operatesFlight)."@en ;
                  rdfs:label "flight operated by"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#forecastBy
:forecastBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Flight ;
            rdfs:range :TAF ;
            rdfs:comment "Relates a flight to a terminal aerodrome forecast relevant to its conduct."@en ;
            rdfs:label "forecast by"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#goesThroughScreening
:goesThroughScreening rdf:type owl:ObjectProperty ;
                      rdfs:domain :Passenger ;
                      rdfs:range :SecurityScreening ;
                      rdfs:comment "Relates a passenger to a security screening they go through."@en ;
                      rdfs:label "goes through screening"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#handledByFreightForwarder
:handledByFreightForwarder rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf :hasParty ;
                           rdfs:domain :Consignment ;
                           rdfs:range :FreightForwarder ;
                           rdfs:comment "Indicates that a freight forwarder is managing the shipment."@en ;
                           rdfs:label "handled by freight forwarder"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasAirOperatorCertificate
:hasAirOperatorCertificate rdf:type owl:ObjectProperty ;
                           rdfs:domain :Airline ;
                           rdfs:range :AirOperatorCertificate ;
                           rdfs:comment "Relates an airline to its air operator certificate."@en ;
                           rdfs:label "has air operator certificate"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasArrivalNotice
:hasArrivalNotice rdf:type owl:ObjectProperty ;
                  rdfs:domain :Consignment ;
                  rdfs:range :ArrivalNotice ;
                  rdfs:comment "Links the cargo to the document confirming its arrival."@en ;
                  rdfs:label "has arrival notice"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasBoardingPass
:hasBoardingPass rdf:type owl:ObjectProperty ;
                 rdfs:domain :Passenger ;
                 rdfs:range :BoardingPass ;
                 rdfs:comment "Relates a passenger to their boarding pass."@en ;
                 rdfs:label "has boarding pass"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasCertificateOfAirworthiness
:hasCertificateOfAirworthiness rdf:type owl:ObjectProperty ;
                               rdfs:domain :Aircraft ;
                               rdfs:range :CertificateOfAirworthiness ;
                               rdfs:comment "Relates an aircraft to its certificate of airworthiness."@en ;
                               rdfs:label "has certificate of airworthiness"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasChargingPoint
:hasChargingPoint rdf:type owl:ObjectProperty ;
                  rdfs:domain :AirDepot ;
                  rdfs:range :ChargingPoint ;
                  rdfs:comment "Relates a depot to a charging point it hosts."@en ;
                  rdfs:label "has charging point"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasConsignee
:hasConsignee rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasParty ;
              rdfs:domain :Consignment ;
              rdfs:range :Consignee ;
              rdfs:comment "Relates a consignment to its consignee."@en ;
              rdfs:label "has consignee"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasCrewMember
:hasCrewMember rdf:type owl:ObjectProperty ;
               rdfs:domain :Flight ;
               rdfs:range :CrewMember ;
               rdfs:comment "Relates a flight to any member of its crew. Super-property of crewedBy (flight crew) and servedBy (cabin crew)."@en ;
               rdfs:label "has crew member"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasDestination
:hasDestination rdf:type owl:ObjectProperty ;
                rdfs:domain :Consignment ;
                rdfs:comment "Connects a shipment to its delivery location."@en ;
                rdfs:label "has destination"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasDispatchSchedule
:hasDispatchSchedule rdf:type owl:ObjectProperty ;
                     rdfs:domain :Consignment ;
                     rdfs:range :DispatchSchedule ;
                     rdfs:comment "Associates a shipment with its planned dispatch date and time."@en ;
                     rdfs:label "has dispatch schedule"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasExporter
:hasExporter rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasParty ;
             rdfs:domain :Consignment ;
             rdfs:range :Exporter ;
             rdfs:comment "Relates a shipment to the exporter responsible for dispatching it."@en ;
             rdfs:label "has exporter"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasFlightSchedule
:hasFlightSchedule rdf:type owl:ObjectProperty ;
                   rdfs:domain :Airline ;
                   rdfs:range :FlightSchedule ;
                   rdfs:comment "Relates an airline to its flight schedule."@en ;
                   rdfs:label "has flight schedule"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasImporter
:hasImporter rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasParty ;
             rdfs:domain :Consignment ;
             rdfs:range :Importer ;
             rdfs:comment "Relates a shipment to the importer receiving the goods."@en ;
             rdfs:label "has importer"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasIntermediateStop
:hasIntermediateStop rdf:type owl:ObjectProperty ;
                     rdfs:domain :Flight ;
                     rdfs:range :Aerodrome ;
                     rdfs:comment "Relates a flight to an aerodrome at which it stops between departure and final arrival."@en ;
                     rdfs:label "has intermediate stop"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasInvoice
:hasInvoice rdf:type owl:ObjectProperty ;
            rdfs:domain :Consignment ;
            rdfs:range :Invoice ;
            rdfs:comment "Connects a shipment to its invoice for value declaration."@en ;
            rdfs:label "has invoice"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasLabel
:hasLabel rdf:type owl:ObjectProperty ;
          rdfs:domain :Cargo ;
          rdfs:range :Label ;
          rdfs:comment "Connects cargo to a label containing flight and safety information."@en ;
          rdfs:label "has label"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasMedicalCertificate
:hasMedicalCertificate rdf:type owl:ObjectProperty ;
                       rdfs:domain :CrewMember ;
                       rdfs:range :MedicalCertificate ;
                       rdfs:comment "Relates a crew member to their medical certificate."@en ;
                       rdfs:label "has medical certificate"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasOrigin
:hasOrigin rdf:type owl:ObjectProperty ;
           rdfs:domain :Consignment ;
           rdfs:comment "Connects a shipment to its starting point."@en ;
           rdfs:label "has origin"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasPackingCompany
:hasPackingCompany rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasParty ;
                   rdfs:domain :Consignment ;
                   rdfs:range :PackingCompany ;
                   rdfs:comment "Associates the cargo with the company responsible for packing."@en ;
                   rdfs:label "has packing company"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasPackingList
:hasPackingList rdf:type owl:ObjectProperty ;
                rdfs:domain :Consignment ;
                rdfs:range :PackingList ;
                rdfs:comment "Links a shipment to the packing list outlining its contents."@en ;
                rdfs:label "has packing list"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasPart
:hasPart rdf:type owl:ObjectProperty ;
         owl:inverseOf :partOf ;
         rdf:type owl:TransitiveProperty ;
         rdfs:comment "Relates a whole to one of its parts. Transitive: a part of a part is a part of the whole."@en ;
         rdfs:label "has part"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasParty
:hasParty rdf:type owl:ObjectProperty ;
          rdfs:domain :Consignment ;
          rdfs:range :Agent ;
          rdfs:comment "Relates a consignment to any agent involved in it. Super-property of shipper, consignee, exporter, importer, forwarder, packer and carrier relations, so 'who is involved in this shipment?' is one query."@en ;
          rdfs:label "has party"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasShipper
:hasShipper rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasParty ;
            rdfs:domain :Consignment ;
            rdfs:range :Shipper ;
            rdfs:comment "Relates a consignment to its shipper."@en ;
            rdfs:label "has shipper"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasShippingInstruction
:hasShippingInstruction rdf:type owl:ObjectProperty ;
                        rdfs:domain :Consignment ;
                        rdfs:range :ShippingInstruction ;
                        rdfs:comment "Connects the export request to the shipping instructions."@en ;
                        rdfs:label "has shipping instruction"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasTypeCertificate
:hasTypeCertificate rdf:type owl:ObjectProperty ;
                    rdfs:domain :AircraftType ;
                    rdfs:range :TypeCertificate ;
                    rdfs:comment "Relates an aircraft type to its type certificate."@en ;
                    rdfs:label "has type certificate"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasTypeRating
:hasTypeRating rdf:type owl:ObjectProperty ;
               rdfs:domain :FlightCrew ;
               rdfs:range :TypeRating ;
               rdfs:comment "Relates a pilot to a type rating they hold."@en ;
               rdfs:label "has type rating"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#hasWarehouse
:hasWarehouse rdf:type owl:ObjectProperty ;
              rdfs:domain :Consignment ;
              rdfs:range :Warehouse ;
              rdfs:comment "Indicates the warehouse where the cargo is stored."@en ;
              rdfs:label "has warehouse"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#holdsLicense
:holdsLicense rdf:type owl:ObjectProperty ;
              rdfs:domain :Person ;
              rdfs:range :Licence ;
              rdfs:comment "Relates a person to a licence they hold."@en ;
              rdfs:label "holds license"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#holdsRoleOf
:holdsRoleOf rdf:type owl:ObjectProperty ;
             rdfs:domain :Person ;
             rdfs:range :Stakeholder ;
             rdfs:comment "Relates a person to a stakeholder role they hold in an operation."@en ;
             rdfs:label "holds role of"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#includesCargoItem
:includesCargoItem rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasPart ;
                   rdfs:domain :Consignment ;
                   rdfs:range :Cargo ;
                   rdfs:comment "Associates a shipment with its individual cargo items."@en ;
                   rdfs:label "includes cargo item"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#includesULD
:includesULD rdf:type owl:ObjectProperty ;
             rdfs:domain :Consignment ;
             rdfs:range :ULD ;
             rdfs:comment "Connects a shipment to the ULD in which it is consolidated."@en ;
             rdfs:label "includes ULD"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#insuredBy
:insuredBy rdf:type owl:ObjectProperty ;
           rdfs:domain :Aircraft ;
           rdfs:range :InsuranceProvider ;
           rdfs:comment "Relates an aircraft to the organization providing its insurance cover."@en ;
           rdfs:label "insured by"@en .


###  http://www.cranfield.ac.uk/ontology/air-domain#interlinkedWithRoad
:interlinkedWithRoad rdf:type owl:ObjectProperty ;
                     rdfs:domain :AirNetwork ;
                     rdfs:range :RoadNetwork ;
                     rdfs:comment "Relates an air network to an interlinked road network."@en ;
                     rdfs:label "interlinked with road"@en .


