:usesICAOCode rdf:type owl:ObjectProperty ;
              rdfs:range :ICAOCode ;
              rdfs:comment "Relates an airport, airline, or aircraft to its ICAO code."@en ;
              rdfs:label "uses ICAO code"@en .


